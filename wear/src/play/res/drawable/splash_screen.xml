<?xml version="1.0" encoding="utf-8"?>
<!-- The Play build's branded launch: the same 48dp layer as main's splash_screen.xml, holding the
     icon the Play build actually launches with. Wear OS app quality (WO-V15) requires the splash
     icon to match the launcher icon, and the Play build's default launcher entry is
     .LauncherIconGradient (see this flavor's manifest) - main's plain ic_launcher is the GitHub
     build's icon and only matches the alternative solid entry. A splash theme is fixed per
     activity, so it follows the default entry that a reviewer and a new install see. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/splash_screen_icon_size"
        android:height="@dimen/splash_screen_icon_size"
        android:drawable="@mipmap/ic_launcher_play_gradient"
        android:gravity="center" />
</layer-list>
