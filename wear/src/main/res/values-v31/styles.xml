<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ shows this before MainActivity can draw. Use the same unmasked brand mark as
         the in-app reveal so there is no intermediate launcher-icon card on the watch. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/theme_accent</item>
        <item name="colorPrimaryDark">@color/theme_accent</item>
        <item name="colorAccent">@color/theme_accent</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/svartifoss_splash_logo</item>
    </style>

</resources>
