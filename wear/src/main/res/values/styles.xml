<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/theme_accent</item>
        <item name="colorPrimaryDark">@color/theme_accent</item>
        <item name="colorAccent">@color/theme_accent</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>

    <!-- Theme for the full-screen Compose screens (queue, actions menu). Deliberately OPAQUE:
         these windows used to be translucent so the swipe-back revealed the live player behind,
         but that forced the GPU to alpha-blend two full-screen surfaces on every frame and kept
         MainActivity rendering underneath - the main remaining cause of scroll stutter vs. the
         stock media app. Opaque means the swipe reveals black and MainActivity fully stops while
         covered (the activities bind WatchMusicService themselves to keep the phone connection
         alive). No window animation (the SwipeToDismissBox animates the close itself) and no
         system swipe-to-dismiss (Compose handles the swipe, so the system one must not also
         fire). -->
    <style name="QueueTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>