<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/theme_accent</item>
        <item name="colorPrimaryDark">@color/theme_accent</item>
        <item name="colorAccent">@color/theme_accent</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <!-- Pure black instead of the gray AppCompat default: it is what AMOLED watches want, and
             the first frame the user sees after the branded launch below. -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- The theme MainActivity is *launched* with: the branded launch that Google's Wear OS app
         quality review (WO-V15) checks - the launcher icon, round and 48dp, on a black window.
         Google's documented route is the androidx SplashScreen library, "to ensure it displays
         correctly on all Wear OS versions", so that is what this is: on Android 12+ it maps onto
         the platform splash screen, below that it draws the same thing in the window background.
         It hands over to AppTheme the moment MainActivity calls installSplashScreen().

         Only the *launcher* activity needs it. The other activities are only ever opened from
         inside the app (QueueTheme) or by the Tile trampoline, and none of them is an app start.

         The icon is the launcher icon itself rather than a separate mark: the guideline says the
         splash icon must match it, and an earlier splash drew the bare mark on black, which a
         reviewer reads as a different icon. See splash_screen.xml for how it gets its size. -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Theme for the full-screen Compose screens (queue, actions menu). Deliberately OPAQUE:
         these windows used to be translucent so the swipe-back revealed the live player behind,
         but that forced the GPU to alpha-blend two full-screen surfaces on every frame and kept
         MainActivity rendering underneath - the main remaining cause of scroll stutter vs. the
         stock media app. Opaque means the swipe reveals black and MainActivity fully stops while
         covered (the activities bind WatchMusicService themselves to keep the phone connection
         alive). No window animation (the SwipeToDismissBox animates the close itself) and no
         system swipe-to-dismiss (Compose handles the swipe, so the system one must not also
         fire). -->
    <style name="QueueTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSwipeToDismiss">false</item>
    </style>
</resources>