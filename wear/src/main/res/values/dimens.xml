<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="music_screen_icon_offset">4dp</dimen>
    <dimen name="music_screen_icon_size">24dp</dimen>
    <dimen name="music_screen_text_margin">30dp</dimen>
    <dimen name="seek_bar_width">6dp</dimen>
    <!-- The control is intentionally bezel-only. A wider band sits above the Compose faces and
         steals taps from Expressive's side buttons and Spectrum's far-right seek bars. -->
    <dimen name="seek_bar_touch_band">10dp</dimen>

    <dimen name="center_tap_zone_size">110dp</dimen>

    <dimen name="notification_margin">6dp</dimen>

    <dimen name="quick_action_button_width">58dp</dimen>
    <dimen name="quick_action_button_height">52dp</dimen>
    <dimen name="quick_action_icon_size">26dp</dimen>
    <!-- Height of every full-width quick-panel pill (Up Next and the action/shortcut rows).
         Fixed rather than wrap_content on purpose: the action rows are sized by their 30dp icon
         while Up Next stacks a two-line label, so content-driven heights made otherwise identical
         pills differ by ~6% and the list read as ragged. -->
    <dimen name="quick_action_row_height">54dp</dimen>

    <dimen name="screen_button_width">46dp</dimen>
    <dimen name="screen_button_height">38dp</dimen>
</resources>
