<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start window background: pure black (AMOLED-friendly, matches the app content that
     replaces it) with the Svartifoss mark centered. The activity continues it with an animated
     reveal as soon as its first frame is ready. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="center"
        android:drawable="@drawable/svartifoss_splash_logo" />
</layer-list>
