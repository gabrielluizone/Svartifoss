<?xml version="1.0" encoding="utf-8"?>
<!-- Base geometry for ic_equalizer_bars_animated.xml (the "Up Next" icon while music plays) -
     also used standalone as the paused/stopped state, with each bar's scaleY authored to a
     varied static height so it still reads as an equalizer glyph rather than 3 identical bars.
     Bars are fully-rounded capsules (like the Compose NowPlayingBars in the queue screen, which
     draws round-cornered bars - keep the two looking like the same glyph). Bar paths are drawn
     full-height (as if scaleY=1); each group's pivot sits at the bar's own bottom edge so the
     animator (see res/animator/equalizer_barN.xml) scales it from there. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:name="bar1_group"
        android:pivotX="7"
        android:pivotY="20"
        android:scaleY="0.35">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M5.5,5.5 A1.5,1.5 0 0 1 8.5,5.5 L8.5,18.5 A1.5,1.5 0 0 1 5.5,18.5 Z" />
    </group>
    <group
        android:name="bar2_group"
        android:pivotX="12"
        android:pivotY="20"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.5,5.5 A1.5,1.5 0 0 1 13.5,5.5 L13.5,18.5 A1.5,1.5 0 0 1 10.5,18.5 Z" />
    </group>
    <group
        android:name="bar3_group"
        android:pivotX="17"
        android:pivotY="20"
        android:scaleY="0.45">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15.5,5.5 A1.5,1.5 0 0 1 18.5,5.5 L18.5,18.5 A1.5,1.5 0 0 1 15.5,18.5 Z" />
    </group>
</vector>
