<?xml version="1.0" encoding="utf-8"?>
<!-- Soft ring flashed at screen center the instant a center tap lands. A ring (not a filled dot)
     stays readable on top of any album art without hiding it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#26FFFFFF" />
    <stroke
        android:width="1.5dp"
        android:color="#B3FFFFFF" />
</shape>
