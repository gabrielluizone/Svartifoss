<?xml version="1.0" encoding="utf-8"?>
<!-- Animated "now playing" equalizer for the Up Next icon - same 3-bar look/timing as
     NowPlayingBars in QueueScreen.kt, ported to a View-based AnimatedVectorDrawable since the
     legacy quick-actions panel isn't Compose. Started/stopped from MainActivity based on
     playback state; see ic_equalizer_bars.xml for the paused/stopped static pose. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_equalizer_bars">
    <target android:name="bar1_group" android:animation="@animator/equalizer_bar1" />
    <target android:name="bar2_group" android:animation="@animator/equalizer_bar2" />
    <target android:name="bar3_group" android:animation="@animator/equalizer_bar3" />
</animated-vector>
