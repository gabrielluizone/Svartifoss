<?xml version="1.0" encoding="utf-8"?>
<!-- A short, paged first-run lesson. The opaque, clickable root absorbs player gestures while
     the guide is open; only the explicit navigation buttons advance or complete it.

     Laid out for a 192dp round watch first (Pixel Watch, Galaxy Watch and the "small round"
     emulator that Google's Wear OS review uses), because that is where it was cut off: the
     content was boxed to the display's inscribed square, about 136dp tall, and the title, the
     counter and a 48dp button row took 84dp of it, leaving 52dp for a page that needs five lines.
     So only the left and right edges are boxed; the vertical padding keeps the title and the buttons
     inside the glass instead of leaving a square's worth of margin all round. And each page sizes
     its own text to the room left (autoSize), so a longer translation gets smaller type rather than
     being cut off at the bottom of the page. The ceiling is in sp, so the user's font size still
     applies while there is room; the floor is in dp, because an sp floor grows with the font size
     and a large one left the pages cut off again (checked at a 1.3 scale). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:ignore="KeyboardInaccessibleWidget"
    tools:visibility="visible">

    <androidx.wear.widget.BoxInsetLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingTop="12dp"
            android:paddingRight="6dp"
            android:paddingBottom="16dp"
            app:boxedEdges="left|right">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/hint_title"
                android:textColor="@color/theme_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/first_run_hints_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:accessibilityLiveRegion="polite"
                android:includeFontPadding="false"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                tools:text="1 / 4" />

            <!-- The pages take whatever the header and the buttons leave. Each is one TextView
                 that shrinks (never below 9sp) until its whole text fits, centred in that room. -->
            <ViewFlipper
                android:id="@+id/first_run_hints_pages"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:measureAllChildren="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="9dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/hint_center"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="9dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/hint_edges"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="9dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/hint_swipe_up"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="9dp"
                    android:autoSizeStepGranularity="0.5dp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/hint_crown"
                    android:textColor="@color/white" />
            </ViewFlipper>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/first_run_hints_back"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/back_button"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/first_run_hints_next"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/glass_pill_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/hint_next"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.wear.widget.BoxInsetLayout>
</FrameLayout>
