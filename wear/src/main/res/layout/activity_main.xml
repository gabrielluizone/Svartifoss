<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/black">

    <!-- Wrapper (rather than putting everything straight into the root) so ambient burn-in
         protection has a single view to jiggle/reset - see onUpdateAmbient in MainActivity.
         The first-run hints overlay deliberately sits outside it. -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:deviceIds="wear">

        <ImageView
            android:id="@+id/album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Native background-treatment layer for the View-based Classic layout. Compose faces
             draw the same treatment inside their own canvas and keep this View hidden. -->
        <View
            android:id="@+id/player_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/album_art_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/album_art_scrim" />

        <!-- Idle ("nothing playing") state: animated equalizer glyph + friendly text on pure
             black, shown by MainActivity instead of the old bare "Playback Stopped" line when
             there is no track at all. Not clickable - taps fall through to the gesture layers,
             so stopped-config buttons/gestures still work to start playback. -->
        <LinearLayout
            android:id="@+id/idle_state_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/idle_state_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_equalizer_bars_animated"
                app:tint="@color/theme_accent"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/idle_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:text="@string/idle_nothing_playing"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/idle_state_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:includeFontPadding="false"
                android:text="@string/idle_hint"
                android:textColor="@color/glass_surface_subtitle_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- The classic face's centered text block. Hidden as a whole while the expressive
             face is selected (its children keep being updated regardless - ambient mode and
             the quick panel read from them for both faces). -->
        <androidx.wear.widget.BoxInsetLayout
            android:id="@+id/classic_text_block"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/music_screen_text_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:boxedEdges="all">

                <com.svartifoss.snfell.watch.view.OutlineTextView
                    android:id="@+id/text_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/theme_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Artist" />

                <com.svartifoss.snfell.watch.view.OutlineTextView
                    android:id="@+id/text_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/white"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    tools:text="Title" />

                <com.svartifoss.snfell.watch.view.OutlineTextView
                    android:id="@+id/text_playback_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="1:23 / 3:45"
                    tools:visibility="visible" />

            </LinearLayout>

        </androidx.wear.widget.BoxInsetLayout>

        <com.svartifoss.snfell.common.view.FourWayTouchLayout
            android:id="@+id/four_way_touch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:deviceIds="wear"
            tools:ignore="KeyboardInaccessibleWidget">

            <ImageView
                android:id="@+id/icon_top"
                android:layout_width="@dimen/music_screen_icon_size"
                android:layout_height="@dimen/music_screen_icon_size"
                android:layout_gravity="center|top"
                android:layout_marginTop="@dimen/music_screen_icon_offset"
                tools:ignore="ContentDescription"
                tools:src="@drawable/action_volume_up" />

            <ImageView
                android:id="@+id/icon_bottom"
                android:layout_width="@dimen/music_screen_icon_size"
                android:layout_height="@dimen/music_screen_icon_size"
                android:layout_gravity="center|bottom"
                android:layout_marginBottom="@dimen/music_screen_icon_offset"
                tools:ignore="ContentDescription"
                tools:src="@drawable/action_volume_down" />

            <ImageView
                android:id="@+id/icon_left"
                android:layout_width="@dimen/music_screen_icon_size"
                android:layout_height="@dimen/music_screen_icon_size"
                android:layout_gravity="center|left"
                android:layout_marginLeft="@dimen/music_screen_icon_offset"
                tools:ignore="ContentDescription,RtlHardcoded"
                tools:src="@drawable/action_pause" />

            <ImageView
                android:id="@+id/icon_right"
                android:layout_width="@dimen/music_screen_icon_size"
                android:layout_height="@dimen/music_screen_icon_size"
                android:layout_gravity="center|right"
                android:layout_marginRight="@dimen/music_screen_icon_offset"
                tools:ignore="ContentDescription,RtlHardcoded"
                tools:src="@android:mipmap/sym_def_app_icon" />

            <TextView
                android:id="@+id/ambient_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:fontFamily="@font/google_sans"
                android:paddingTop="5sp"
                android:textColor="@color/ambient_clock_color"
                android:textSize="15sp"
                android:visibility="gone" />

            <requestFocus />

        </com.svartifoss.snfell.common.view.FourWayTouchLayout>

        <!-- Tapping the middle of the screen toggles play/pause directly, regardless of how
             the four quadrants are configured - sits above FourWayTouchLayout but is small
             enough to leave the quadrants reachable everywhere outside its bounds. -->
        <View
            android:id="@+id/center_tap_zone"
            android:layout_width="@dimen/center_tap_zone_size"
            android:layout_height="@dimen/center_tap_zone_size"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="KeyboardInaccessibleWidget" />

        <!-- Instant "tap registered" pulse for center_tap_zone. The single-tap action itself
             only fires after the double-tap timeout (~300ms, to disambiguate from a double
             tap), which used to make play/pause feel dead for that beat - this ring flashes on
             the initial touch-down instead, before either gesture is decided. Not clickable, so
             touches pass straight through it. -->
        <View
            android:id="@+id/center_tap_pulse"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/center_tap_pulse" />

        <!-- The expressive now-playing face (see NowPlayingFace.kt). Sits above the gesture
             layers so its transport buttons win touch dispatch, but below the mini buttons and
             every overlay (blur, volume/seek, quick panel) so those keep covering the face.
             Touches on its non-interactive areas fall through to FourWayTouchLayout, keeping
             quadrant taps and swipe gestures working. GONE unless the "expressive" face is
             selected on the phone (wear_screen_face); ambient always hides it. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/expressive_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Mirrors FourWayTouchLayout's own tap-feedback pulse at a higher z-order: that
             layout's ripple is a child of itself, so it is drawn UNDER expressive_face and every
             curated face's opaque backdrop and is invisible whenever one of them is showing.
             MainActivity.onTouchDown/onTouchUp (FourWayTouchLayout.UserActionListener) drives
             this drawable in lockstep, but only while a Compose face is active - Classic already
             has a visible ripple and does not need a second one drawn on top. Not clickable, so
             touches pass straight through it, same as center_tap_pulse. -->
        <ImageView
            android:id="@+id/compose_tap_pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="ContentDescription" />

        <!-- User-configurable mini buttons (see ScreenButtons in common). A *fixed* overlay
             near the bottom of the screen, deliberately independent of the centered text block
             so it never shifts with 1- vs 2-line titles (and never pushes the text off-center).
             Ordered after center_tap_zone so its buttons win touch dispatch over both the
             center play/pause zone and FourWayTouchLayout, but before the blur/volume/seek
             overlays so those still cover it. Bottom margin is user-tunable from the phone's
             developer settings (screen_buttons_bottom_offset); 42dp default clears the bottom
             quadrant icon and keeps the full 3-button row inside a round screen's circle.
             Row and unconfigured slots stay gone, so the screen is unchanged until the user
             assigns something on the phone. -->
        <LinearLayout
            android:id="@+id/screen_buttons_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="42dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/screen_button_1"
                android:layout_width="@dimen/screen_button_width"
                android:layout_height="@dimen/screen_button_height"
                android:layout_marginEnd="5dp"
                android:background="@drawable/glass_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:src="@drawable/action_open_playlist"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/screen_button_2"
                android:layout_width="@dimen/screen_button_width"
                android:layout_height="@dimen/screen_button_height"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/glass_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:src="@drawable/action_like"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/screen_button_3"
                android:layout_width="@dimen/screen_button_width"
                android:layout_height="@dimen/screen_button_height"
                android:layout_marginStart="5dp"
                android:background="@drawable/glass_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:src="@drawable/action_shuffle"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- One full-screen compositing group for blur + gradient/dim. It stays before the panel
             content so rings and actions draw on top, and absorbs stray touches outside them.
             Animating this parent (rather than both children) prevents a visible two-stage blur. -->
        <FrameLayout
            android:id="@+id/overlay_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:ignore="KeyboardInaccessibleWidget">

            <ImageView
                android:id="@+id/overlay_blur_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <!-- This gradient/dim layer and the blur are children of one alpha-composited group.
                 They must enter and leave together: separate sibling animations visibly applied
                 the gradient a frame after the blur during volume and bezel seeking. -->
            <View
                android:id="@+id/overlay_dim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/overlay_dim_color" />

        </FrameLayout>

        <com.svartifoss.snfell.watch.view.CircularProgressSeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.svartifoss.snfell.watch.view.CircularVolumeBar
            android:id="@+id/volume_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/volume_icon_top"
            android:layout_width="@dimen/music_screen_icon_size"
            android:layout_height="@dimen/music_screen_icon_size"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="@dimen/music_screen_icon_offset"
            android:src="@drawable/volume_icon_up_outline"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/volume_icon_bottom"
            android:layout_width="@dimen/music_screen_icon_size"
            android:layout_height="@dimen/music_screen_icon_size"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="@dimen/music_screen_icon_offset"
            android:src="@drawable/volume_icon_down_outline"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <com.svartifoss.snfell.watch.view.OutlineTextView
            android:id="@+id/text_volume_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="65%"
            tools:visibility="visible" />

        <com.svartifoss.snfell.watch.view.OutlineTextView
            android:id="@+id/text_seek_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1:45"
            tools:visibility="visible" />

        <com.svartifoss.snfell.watch.view.OverlayProgressMeter
            android:id="@+id/seek_overlay_meter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Quick-actions panel: like/shuffle/repeat + a shortcut into the queue, opened by
             double-tapping center_tap_zone (single tap there still toggles play/pause). Sits on
             top of the same blur/dim overlay used by the volume and seek previews. Content uses
             safe side padding while the scroll host reaches the bezel for its curved indicator. -->
        <androidx.wear.widget.SwipeDismissFrameLayout
            android:id="@+id/quick_actions_dismiss_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

        <com.svartifoss.snfell.watch.view.CircularQuickActionsScrollView
            android:id="@+id/quick_actions_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadeScrollbars="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quick_actions_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:clipChildren="false"
                android:paddingTop="32dp"
                android:paddingBottom="30dp">

            <com.svartifoss.snfell.watch.view.OutlineTextView
                android:id="@+id/quick_action_panel_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Title" />

            <com.svartifoss.snfell.watch.view.OutlineTextView
                android:id="@+id/quick_action_panel_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/theme_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Artist" />

            <LinearLayout
                android:id="@+id/quick_action_round_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/quick_action_like"
                    android:layout_width="@dimen/quick_action_button_width"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_pill_background"
                    android:clickable="true"
                    android:contentDescription="@string/quick_action_like"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/action_like" />

                <ImageView
                    android:id="@+id/quick_action_shuffle"
                    android:layout_width="@dimen/quick_action_button_width"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_pill_background"
                    android:clickable="true"
                    android:contentDescription="@string/quick_action_shuffle"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/action_shuffle" />

                <ImageView
                    android:id="@+id/quick_action_repeat"
                    android:layout_width="@dimen/quick_action_button_width"
                    android:layout_height="@dimen/quick_action_button_height"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/glass_pill_background"
                    android:clickable="true"
                    android:contentDescription="@string/quick_action_repeat"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/action_repeat" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_up_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/up_next_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/quick_action_button_height"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="11dp"
                android:paddingEnd="20dp"
                android:paddingBottom="11dp">

                <ImageView
                    android:id="@+id/quick_action_up_next_artwork"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/artwork_round_mask"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/ic_queue_music" />

                <ImageView
                    android:id="@+id/quick_action_up_next_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_queue_music"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quick_action_up_next_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:text="@string/quick_action_up_next"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/quick_action_up_next_track"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/glass_surface_subtitle_text"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Next track name"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

            <!-- User-configured action-menu entries are mirrored here as full-width rows. The
                 container makes the panel genuinely scrollable and lets playlists/search/other
                 useful actions be reached without shrinking the three primary media buttons. -->
            <LinearLayout
                android:id="@+id/quick_action_extra_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            </LinearLayout>

        </com.svartifoss.snfell.watch.view.CircularQuickActionsScrollView>

        </androidx.wear.widget.SwipeDismissFrameLayout>

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <include
            android:id="@+id/notification_popup"
            layout="@layout/popup_notification" />

    </FrameLayout>

    <!-- Optional diagnostics controlled from phone developer settings. Kept outside content_frame
         so it observes the final, post-jiggle geometry without participating in layout itself. -->
    <com.svartifoss.snfell.watch.view.DeveloperOverlayView
        android:id="@+id/developer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Outside content_frame so the ambient burn-in jiggle never moves it. -->
    <include
        android:id="@+id/first_run_hints"
        layout="@layout/overlay_first_run_hints"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
