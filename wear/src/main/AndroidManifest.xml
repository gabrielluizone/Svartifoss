<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required since targetSdk 34 (Android 14): a foreground service must declare its type
         and hold the matching permission, or startForeground() throws. WatchMusicService keeps
         the phone connection alive while music plays / the UI is open and shows a transport
         OngoingActivity, so mediaPlayback is the closest-fitting type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The other foreground service, wearutils' LogTransmitter: it streams this watch's log
         files to the phone over a Data Layer channel, which is what dataSync describes. It
         declares no type of its own (the library predates the requirement) and calls
         startForeground() in onCreate, so without this the "send logs" diagnostic died with
         MissingForegroundServiceTypeException the moment the phone asked for logs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- targetSdk 33+ (Android 13): notifications, including the foreground service's
         OngoingActivity, require this permission. Requested once at runtime in MainActivity so
         the notification keeps showing as it did pre-33. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- REQUEST_INSTALL_PACKAGES and the watch self-update receiver are declared by the `github`
         flavor only - see src/github/AndroidManifest.xml. The Play build must not carry them;
         Play delivers watch updates itself. -->

    <application
        android:name=".watch.WearMusicCenter"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_short"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />
        <!--
             This flag governs *distribution*, not function: it tells Play whether the watch half
             may be installed on a watch on its own. It is not a claim that the app is useful
             without the phone - it plainly is not, and nothing about that changed.

             It was `false`, which is the honest reading of the sentence Google writes next to it,
             and it made the watch app unreachable. A non-standalone watch app is not listed
             independently on the watch's Play Store - it does not come up in search there - and
             modern Wear OS does not push the companion onto the watch when the phone half is
             installed, the way the old model did. So for anyone who did not already have the app
             in their Play library there was no route to install it at all: no button under the
             phone listing, nothing in the watch's search. Reproduced on a clean account that had
             joined the group and accepted the test invitation, 2026-09-11.

             Nobody is stranded by the watch half arriving first. MainActivity extends
             `WearCompanionWatchActivity`, which shows `PhoneAppNoticeActivity` when the phone app
             is not present, and the `play` flavour's `no_phone_app_description` already sends the
             user to this same listing on their phone.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".watch.view.MainActivity"
            android:label="@string/app_name_short"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.matejdro.wearutils.companionnotice.PhoneAppNoticeActivity" />
        <activity android:name=".watch.input.PinchCalibrationActivity"
            android:launchMode="singleTask"
            android:exported="false" />

        <!-- Invisible bridge launched by a ShortcutsTileService chip: opens the shortcut on the
             phone and asks it to play, then finishes. Exported because the Tile framework (a
             separate system process) starts it; it only accepts a shortcut entry-id it validates
             as a safe URI scheme before opening. -->
        <activity
            android:name=".watch.tile.ShortcutLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".watch.communication.PreferencesReceiver"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/Settings"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".watch.communication.MusicCenterLogRequestReceiver"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />

                <data
                    android:host="*"
                    android:pathPrefix="/SendLogs"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".watch.communication.IdleMessageListener"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/IdleMessages"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Low-latency preference delivery: applies a settings change promptly instead of waiting
             for the /Settings DataItem to sync out of doze. Path must match
             CommPaths.MESSAGE_APPLY_PREFERENCES. -->
        <service
            android:name=".watch.communication.PreferenceMessageReceiver"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/PreferencesSync"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Delivers button-config / action-menu edits even while the watch app is idle, so a
             mapping changed on the phone no longer waits for the user to wake/tap the watch - see
             the class kdoc. Paths must match CommPaths.DATA_ACTION_CONFIG_PREFIX and
             DATA_LIST_ITEMS. -->
        <service
            android:name=".watch.communication.ConfigListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/Actions"
                    android:scheme="wear" />
                <data
                    android:host="*"
                    android:pathPrefix="/ActionList"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- The typeface the user imported on their phone. Its own listener rather than another
             path on ConfigListenerService: that one posts frozen DataItems straight into
             PhoneConnection's LiveData on the callback thread, while this has to open an asset
             channel and read up to two megabytes, which must not run there. -->
        <service
            android:name=".watch.communication.UserFontListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/UserFont"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Keeps the complication/Tile fresh independently of WatchMusicService's lifecycle -
             see the class kdoc. Path must match CommPaths.DATA_MUSIC_STATE. -->
        <service
            android:name=".watch.communication.MusicStateListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/Music/State"
                    android:scheme="wear" />
            </intent-filter>
        </service>


        <!-- .watch.update.ApkReceiverService + .watch.update.InstallResultReceiver (the watch
             self-update path) are registered by the `github` flavor only
             (src/github/AndroidManifest.xml). -->

        <!-- The type has to be declared here rather than in wearutils: the library's own manifest
             carries no entry at all (@SuppressLint("Registered") - it is optional there), so this
             declaration is the only one the merger sees. See FOREGROUND_SERVICE_DATA_SYNC above. -->
        <service
            android:name="com.matejdro.wearutils.logging.LogTransmitter"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="pl.tajchert.exceptionwear.ExceptionService"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".watch.communication.WatchMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Glanceable quick-control Tile -->
        <service
            android:name=".watch.tile.MediaTileService"
            android:exported="true"
            android:label="@string/queue_now_playing"
            android:description="@string/tile_description"
            android:icon="@drawable/ic_tile_now_playing"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_media_preview" />
        </service>

        <!-- Browse Tile: the user's streaming shortcuts, one tap away -->
        <service
            android:name=".watch.tile.ShortcutsTileService"
            android:exported="true"
            android:label="@string/shortcuts_tile_title"
            android:description="@string/shortcuts_tile_description"
            android:icon="@drawable/ic_tile_shortcuts"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_shortcuts_preview" />
        </service>

        <!-- Watch-face complication: current album cover, tap to open the player -->
        <!-- Icon: ic_complication_picker is a full-bleed copy of the glyph used ONLY here - both
             the ic_complication_media inset wrapper and even the raw glyph (built-in Material
             padding) render tiny in the complications picker. The in-slot fallback image keeps
             using the inset version (see the service code). -->
        <service
            android:name=".watch.complication.AlbumArtComplicationDataSourceService"
            android:exported="true"
            android:label="@string/complication_album_art_label"
            android:icon="@drawable/ic_complication_picker"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <!-- Round slots get the bare cover (SMALL_IMAGE/PHOTO_IMAGE); wide slots get
                 LONG_TEXT (cover + title + artist) so the source doesn't render as a lone
                 circle floating in a wide area. SHORT_TEXT stays deliberately unsupported -
                 see the service class kdoc. -->
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SMALL_IMAGE,PHOTO_IMAGE,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <activity
            android:name="androidx.wear.activity.ConfirmationActivity"
            android:exported="false" />

        <activity
            android:name=".watch.view.queue.QueueActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- Dedicated volume/progress screens, reachable only by assigning "Open volume screen" /
             "Open progress screen" to a button, gesture or quick-panel slot - additional to, never
             a replacement for, the existing rotary/gesture-triggered transient overlay. Same
             transient shape as the queue and menu above: noHistory, dismissed on screen-off. -->
        <activity
            android:name=".watch.view.volume.VolumeActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <activity
            android:name=".watch.view.progress.ProgressActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- Compose actions/custom-list menu (replaces the old bottom drawer). noHistory so it
             dismisses on screen-off, matching the drawer's close-on-ambient behavior. -->
        <activity
            android:name=".watch.view.menu.MenuActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop"
            android:noHistory="true" />

        <!-- Synced lyrics. Deliberately NOT noHistory, unlike its three siblings below: it
             supports ambient, and noHistory would destroy it the moment the wrist drops - which
             is the exact case the ambient variant exists for. -->
        <activity
            android:name=".watch.view.lyrics.LyricsActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop" />

        <!-- On-watch face picker (long press the centre of the player). Same noHistory/singleTop
             shape as the queue and menu: it is a transient chooser, not a place to come back to. -->
        <activity
            android:name=".watch.view.facepicker.FacePickerActivity"
            android:exported="false"
            android:theme="@style/QueueTheme"
            android:launchMode="singleTop"
            android:noHistory="true" />
    </application>

</manifest>
