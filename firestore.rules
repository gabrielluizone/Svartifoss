rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
     * A candidate is immutable from every Firebase client. Moderation and publication must use a
     * trusted publisher; an author cannot turn a pending submission into an approved or published
     * one. The only browser-side exception is the separate moderator allowlist documented below:
     * its members may make exactly one pending -> approved/rejected decision, never publish.
     *
     * The profile stays as JSON text instead of an unbounded nested map. Firestore rules enforce
     * the transport envelope and its size; the trusted publication path must still parse it with
     * WatchThemeRepository.parsePublishedProfile and recompute settingsDigest before publishing.
     */
    match /themeIntake/{themeId} {
      allow create: if activeIdentifiedUser()
          && validNewThemeIntake(themeId)
          && validSubmissionQuotaForTheme(themeId);
      /*
       * An author reads their own submissions in every status, which is what lets the app show
       * them a queue with outcomes instead of a write-only hole. That is only safe because the
       * reviewer's identity is no longer on this document: it lives in themeIntakeReview below,
       * which no author can read. Do not reintroduce a reviewer field here.
       */
      allow get, list: if identifiedUser() &&
          (isCommunityThemeModerator() || resource.data.ownerUid == request.auth.uid);
      /*
       * The author's branch is tested first, and the order is load-bearing: a moderator update is
       * only valid alongside a themeIntakeReview record, and evaluating that getAfter for a write
       * that never made one is an evaluation error rather than a clean false. An author who also
       * happens to be a moderator would otherwise be unable to take down their own theme.
       */
      allow update: if identifiedUser() && (
          validAuthorWithdrawal() ||
          (isCommunityThemeModerator() && validModeratorUpdate(themeId)));

      // Deliberately omitted: clients cannot delete or publish an intake item.
    }

    /*
     * Who decided what, kept apart from the submission it decided on.
     *
     * Splitting it out is the whole reason an author can read their own rejected and approved
     * submissions: Firestore rules grant access per document and never per field, so a reviewer
     * UID stored beside the verdict would be readable by exactly the person it is withheld from.
     * Every moderator update to themeIntake must write the matching record here in the same
     * atomic batch, so a decision can never exist without an author.
     */
    match /themeIntakeReview/{themeId} {
      allow get, list: if identifiedUser() && isCommunityThemeModerator();
      allow create, update: if identifiedUser()
          && isCommunityThemeModerator()
          && validThemeId(themeId)
          && validReviewRecord();

      // Deliberately omitted: a review record is never deleted, and never readable by an author.
    }

    /*
     * One optional author screenshot per submission: a real photograph of the theme running on the
     * author's own watch, shown on the gallery's detail screen beside the locally-rendered preview.
     *
     * It is a separate document, written *after* the intake it belongs to, and both halves of that
     * sentence are load-bearing.
     *
     * Separate, because a submission already writes intake, quota, account and name reservation in
     * one atomic batch whose rules share a single 1000-expression budget -- a limit only reached on
     * an account's second submission and reported as an indistinguishable PERMISSION_DENIED. A
     * screenshot has nothing to do with quota or name reservation, so it must not spend that
     * budget. Failing to write it is harmless: the theme is simply published without an image,
     * which is the same state as an author who chose not to attach one.
     *
     * After, because that is what bounds it. A screenshot written first could only ever be checked
     * against an invented UUID, so any signed-in account could store unlimited 128 KB documents
     * outside the three-per-day submission limit. Requiring the intake to already exist, to belong
     * to the caller, and to still be `pending` ties every screenshot to a rate-limited submission
     * and makes an orphan impossible. The `pending` clause is the sharp one: without it an author
     * could attach an image *after* a moderator approved the theme, putting unreviewed bytes
     * straight into a public commit.
     *
     * The surface list is a literal for the same reason the base-face list above is, and for now it
     * holds one value. The path keeps a surface segment anyway so a second surface is a new entry
     * here rather than a migration of every already-published theme.
     */
    match /themeIntakeShots/{themeId}/surfaces/{surface} {
      /*
       * An author reads back what they attached; a moderator reads it to review it. Nobody else
       * can, because until publication this is an unreviewed image.
       */
      allow get, list: if identifiedUser() &&
          (isCommunityThemeModerator() || resource.data.ownerUid == request.auth.uid);
      allow create: if activeIdentifiedUser()
          && validThemeId(themeId)
          && validNewThemeScreenshot(themeId, surface);

      /*
       * Deliberately omitted: a screenshot is immutable once written, so an approved image can
       * never be swapped for another one. Only the trusted publisher removes it, after the bytes
       * are committed or the theme is withdrawn.
       */
    }

    /*
     * This private per-user document makes an intake create rate-limited at the rules boundary.
     * Its lastSubmissionId must point to the exact intake document created in the same atomic
     * transaction (verified with getAfter below), so an APK cannot advance or reset this clock by
     * itself. It is never readable by another user and cannot be listed.
     */
    match /communityThemeSubmissionQuota/{uid} {
      allow get: if identifiedUser() && uid == request.auth.uid;
      /*
       * create and update already say whether a previous quota exists, so each branch asserts the
       * shared contract once and then only how the rolling history moves. This document's rule is
       * the authority on that contract; the themeIntake rule re-checks only the pairing.
       */
      allow create: if activeIdentifiedUser()
          && uid == request.auth.uid
          && validQuotaResult(request.resource.data)
          && validNewSubmissionQuota(request.resource.data);
      allow update: if activeIdentifiedUser()
          && uid == request.auth.uid
          && validQuotaResult(request.resource.data)
          && validUpdatedSubmissionQuota(request.resource.data);

      // Deliberately omitted: a quota can neither be listed nor deleted by a client.
    }

    /*
     * One immutable public identity per submitting account, paired with one globally unique,
     * case-insensitive name reservation. Neither half can be created alone: reciprocal getAfter
     * checks require the first submission transaction to create both atomically. Clients can
     * never rename or release either document; only the trusted account-erasure publisher may do
     * that after the Firebase identity itself has been deleted.
     */
    match /communityThemeAccounts/{uid} {
      allow get: if identifiedUser() && uid == request.auth.uid;
      allow create: if activeIdentifiedUser()
          && uid == request.auth.uid
          && validNewCommunityThemeAccount(uid);
    }

    match /communityThemeAuthorNames/{authorKey} {
      // Availability checks need a point read. Listing all reservations remains forbidden.
      allow get: if identifiedUser();
      allow create: if activeIdentifiedUser()
          && validNewCommunityThemeAuthorName(authorKey);
    }

    /*
     * A like is an immutable, private per-UID vote rather than a client-maintained counter.
     * Counts are derived by the trusted GitHub publisher and baked into the public Pages
     * catalogue, so an APK can never inflate the number used for popularity ordering. A voter
     * can see and remove only their own document; no client can enumerate who liked a theme.
     *
     * These rules deliberately accept an anonymous account, unlike the submission path above.
     * Requiring Google Sign-In to press a heart asks for an identity out of all proportion to the
     * act, so the app provisions an anonymous UID silently instead. The accepted cost is that
     * clearing app data yields a new UID and lets the same person vote again: this ledger is a
     * rough popularity signal, and one vote per account is all it has ever been able to promise.
     *
     * The parent themeIntake record is deliberately not readable to ordinary users, but rules may
     * still inspect its status. This makes a like possible only after the trusted publisher has
     * completed the Git publication and marked that exact intake document `published`.
     */
    match /communityThemeLikes/{themeId}/voters/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create: if communityWritesAllowed()
          && uid == request.auth.uid
          && validThemeId(themeId)
          && isPublishedCommunityTheme(themeId)
          && validNewCommunityThemeLike();
      allow delete: if communityWritesAllowed()
          && uid == request.auth.uid
          && validExistingCommunityThemeLike();

      // Deliberately omitted: votes are never mutable or listable from a Firebase client.
    }

    /*
     * An install is the download signal the static catalogue cannot produce on its own.
     *
     * The gallery is JSON committed to Git and served from Pages, so nothing on the serving side
     * ever sees a download: a byte count there would measure how often a phone refreshed its
     * cached catalogue, not how often somebody took a theme. This ledger is therefore what the
     * public "downloads" number actually counts -- one document per account per theme, written
     * when an install succeeds, aggregated by the trusted publisher exactly like a like.
     *
     * Two differences from a like, both deliberate. It is **create-only**: removing a theme from
     * My themes does not un-download it, and offering a client the delete would turn the number
     * into a live installed-count that walks backwards while the catalogue it is baked into only
     * ever rewrites weekly. And an existing document is left alone rather than refused loudly --
     * the app writes through a transaction that skips the write when one is already there, so
     * re-installing the same theme is silent instead of an error the user cannot act on.
     *
     * Like a vote, it accepts an anonymous account and carries the same accepted cost: clearing
     * app data yields a new UID and lets the same person be counted twice. A popularity signal,
     * not a metered distribution count, and the privacy policy says so.
     */
    match /communityThemeInstalls/{themeId}/installers/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create: if communityWritesAllowed()
          && uid == request.auth.uid
          && validThemeId(themeId)
          && isPublishedCommunityTheme(themeId)
          && validNewCommunityThemeInstall();

      // Deliberately omitted: an install is never mutable, deletable or listable from a client.
    }

    /*
     * A report is the one thing in this feature written *about* somebody else, and every rule
     * here follows from that.
     *
     * It is **moderator-readable and author-readable, never public**: a visible report count
     * would be a brigading tool, and the publisher deliberately never aggregates one into the
     * Pages catalogue. The reporter can read back only their own document, which is what lets the
     * app say "you already reported this" instead of silently accepting a second one.
     *
     * A moderator may `list` the subcollection, which is also what makes the collection-group
     * query behind the moderator page's queue possible. Nothing else may enumerate reporters:
     * knowing who reported a theme is exactly the information an author must not have.
     *
     * It accepts an anonymous account for the same reason a like does -- demanding a Google
     * identity before someone can flag offensive content asks the wrong person to pay -- and
     * carries the same disposable-account caveat. One report per account per theme is all the
     * document id can promise, and the moderator queue is read by a person, not by a threshold.
     *
     * `reason` is a closed vocabulary rather than free text so the queue can be triaged without
     * reading prose. `details` is the optional free-text half, capped hard, moderator-only, never
     * republished anywhere, and deleted with the account that wrote it.
     */
    match /communityThemeReports/{themeId}/themeReporters/{uid} {
      allow get: if signedIn()
          && (uid == request.auth.uid || isCommunityThemeModerator());
      allow list: if isCommunityThemeModerator();
      allow create: if communityWritesAllowed()
          && uid == request.auth.uid
          && validThemeId(themeId)
          && isPublishedCommunityTheme(themeId)
          && validNewCommunityThemeReport();

      // Deliberately omitted: a report is never mutable or deletable from a client. Withdrawing
      // one would let a coordinated group probe which reports a moderator had already acted on.
    }

    /*
     * The moderator queue reads every theme's reports at once, and a collection-group query is
     * the only way to do that without already knowing which themes have any.
     *
     * A rule bound to a concrete parent path does not authorise one: a collection-group query is
     * evaluated against a recursive-wildcard path, so without this block the moderator page falls
     * through to the fail-closed catch-all and reports stay invisible to the only people who can
     * act on them. That is also why the subcollection is named `themeReporters` rather than the
     * obvious `reporters` -- a wildcard rule is written once and then silently applies to every
     * same-named subcollection anywhere in the database, so the name has to be one nothing else
     * will ever plausibly claim.
     *
     * Only `list`, and only for a moderator. Reading a single report keeps going through the
     * concrete rule above, which is the one that also lets a reporter read their own.
     */
    match /{path=**}/themeReporters/{uid} {
      allow list: if isCommunityThemeModerator();
    }

    /*
     * A person's own request to erase their community account, and the one place where the choice
     * about their published themes is recorded.
     *
     * It is create-only from every client, for the same reason an intake document is: the trusted
     * publisher is what carries it out, and a request that could be edited between the Git commit
     * that removes a theme file and the Firestore writes that follow it would let the two halves
     * disagree. That makes deletion deliberately one-way, which the app states before asking.
     *
     * An anonymous account may request this too. Its only trace is a set of private like
     * documents, and refusing to erase them because the account was never named would be the
     * wrong way round -- the less identified someone is, the less standing there is to keep
     * their data.
     *
     * `themeDisposition` is the whole point of the document: "keep" leaves already-published
     * themes public under the pseudonym that was published with them and severs their link to
     * this UID, "delete" withdraws them from the catalogue on the next publication run. Neither
     * value preserves a submission that is not public yet -- there is nothing published to keep.
     */
    match /communityThemeAccountDeletion/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create: if signedIn()
          && uid == request.auth.uid
          && !deletedAccountTombstoneExists()
          && validNewAccountDeletionRequest(uid);

      // Deliberately omitted: a request can neither be listed, edited, nor withdrawn by a client.
    }

    // A service-account-only mirror of IDs that have crossed the Git publication boundary.
    // It lets older hand-authored catalogue entries receive likes without granting browser or APK
    // access to this registry. The trusted publisher creates/reconciles it only after Git push.
    match /communityThemePublished/{themeId} {
      allow read, write: if false;
    }

    // A short-lived server-only tombstone closes the validity window of Firebase ID tokens that
    // were issued before an account was deleted. The publisher removes it only after expiry.
    match /communityThemeDeletedAccounts/{uid} {
      allow read, write: if false;
    }

    // Explicit fail-closed fallback for every other collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    /*
     * A real, externally verifiable identity. Anonymous accounts are free and disposable, so they
     * are accepted for reactions and refused everywhere a per-person limit has to mean something.
     *
     * The linked-provider clause is not redundant. Liking provisions an anonymous account, and the
     * app upgrades that same account in place when the person later signs in to submit -- but
     * `sign_in_provider` names the provider of the original *sign-in event* and keeps reporting
     * "anonymous" after a link until that account signs in afresh. Testing the provider alone
     * would refuse submissions from exactly the people who liked a theme before submitting one,
     * which is the ordinary path through this feature. `identities` does gain the linked provider.
     */
    function identifiedUser() {
      return signedIn() && (
        request.auth.token.firebase.sign_in_provider != "anonymous" ||
        request.auth.token.firebase.identities.keys().hasAny(["google.com"])
      );
    }

    function deletionRequestExistsAfter() {
      return existsAfter(
        /databases/$(database)/documents/communityThemeAccountDeletion/$(request.auth.uid)
      );
    }

    function deletedAccountTombstoneExists() {
      return exists(
        /databases/$(database)/documents/communityThemeDeletedAccounts/$(request.auth.uid)
      );
    }

    function deletedAccountTombstoneExistsAfter() {
      return existsAfter(
        /databases/$(database)/documents/communityThemeDeletedAccounts/$(request.auth.uid)
      );
    }

    /* Refuses a request that is already being erased, including one created in this same batch. */
    function communityWritesAllowed() {
      return signedIn()
          && !deletionRequestExistsAfter()
          && !deletedAccountTombstoneExistsAfter();
    }

    function activeIdentifiedUser() {
      return identifiedUser() && communityWritesAllowed();
    }

    function isPublishedCommunityTheme(themeId) {
      return (exists(/databases/$(database)/documents/themeIntake/$(themeId))
              && get(/databases/$(database)/documents/themeIntake/$(themeId)).data.status == "published")
          || exists(/databases/$(database)/documents/communityThemePublished/$(themeId));
    }

    function validNewCommunityThemeLike() {
      let data = request.resource.data;
      return data.keys().hasOnly(["schemaVersion", "createdAt"])
          && data.keys().hasAll(["schemaVersion", "createdAt"])
          && data.schemaVersion is int
          && data.schemaVersion == 1
          && data.createdAt is timestamp
          && data.createdAt == request.time;
    }

    function validExistingCommunityThemeLike() {
      let data = resource.data;
      return data.keys().hasOnly(["schemaVersion", "createdAt"])
          && data.keys().hasAll(["schemaVersion", "createdAt"])
          && data.schemaVersion is int
          && data.schemaVersion == 1
          && data.createdAt is timestamp;
    }

    function validNewCommunityThemeInstall() {
      let data = request.resource.data;
      return data.keys().hasOnly(["schemaVersion", "createdAt"])
          && data.keys().size() == 2
          && data.schemaVersion is int
          && data.schemaVersion == 1
          && data.createdAt is timestamp
          && data.createdAt == request.time;
    }

    /*
     * `details` is optional, so the shape is checked as "these keys at most, those three exactly"
     * rather than by a single size comparison.
     *
     * The length cap is deliberately small. This text is read by a moderator triaging a queue,
     * never rendered to another user and never published, so the only thing extra room buys is a
     * larger surface for someone to store arbitrary content behind a report button.
     */
    function validNewCommunityThemeReport() {
      let data = request.resource.data;
      return data.keys().hasOnly(["schemaVersion", "createdAt", "reason", "details"])
          && data.keys().hasAll(["schemaVersion", "createdAt", "reason"])
          && data.schemaVersion is int
          && data.schemaVersion == 1
          && data.createdAt is timestamp
          && data.createdAt == request.time
          && data.reason in [
            "inappropriate", "impersonation", "misleading", "illegible", "spam", "other"
          ]
          && (!data.keys().hasAny(["details"]) || validShortText(data.details, 300));
    }

    function validNewAccountDeletionRequest(uid) {
      let data = request.resource.data;
      return data.keys().hasOnly([
            "ownerUid",
            "requestSchemaVersion",
            "status",
            "themeDisposition",
            "clientVersion",
            "createdAt"
          ])
          && data.keys().hasAll([
            "ownerUid",
            "requestSchemaVersion",
            "status",
            "themeDisposition",
            "clientVersion",
            "createdAt"
          ])
          && data.ownerUid is string
          && data.ownerUid == uid
          && data.requestSchemaVersion is int
          && data.requestSchemaVersion == 1
          && data.status == "pending"
          && data.themeDisposition in ["keep", "delete"]
          && validShortText(data.clientVersion, 64)
          && data.createdAt is timestamp
          && data.createdAt == request.time;
    }

    /*
     * Firestore's server/Admin SDK bypasses rules and is the only way to create this allowlist.
     * The Firebase Console also uses administrative credentials, so the project owner can create
     * `communityThemeModerators/<their Firebase Auth UID>` without ever exposing moderator power
     * to the APK or a public page. The document's contents are irrelevant; its existence is the
     * explicit access grant. It has no client read/write rule.
     */
    function isCommunityThemeModerator() {
      return exists(
        /databases/$(database)/documents/communityThemeModerators/$(request.auth.uid)
      );
    }

    /*
     * The four things a moderator may do to a submission, each pinned to the exact transition it
     * describes and each recorded in themeIntakeReview by the same batch.
     *
     * Note where the self-moderation ban applies and where it does not. Nobody may approve, reject
     * or reopen their own submission -- that is the rule keeping a moderator from publishing
     * themselves into the gallery. Taking a theme down and fixing its public name are not that:
     * withholding them would only mean the one person able to act on a bad listing is barred from
     * acting on their own.
     */
    function validModeratorUpdate(themeId) {
      let before = resource.data;
      let after = request.resource.data;
      return reviewRecordMatches(themeId, before.status, after.status)
          && ((before.ownerUid != request.auth.uid
                && (validModeratorDecision(before, after) || validModeratorReopen(before, after)))
              || validModeratorWithdrawal(before, after)
              || validModeratorMetadataEdit(before, after));
    }

    /*
     * An author taking their own theme out of the gallery.
     *
     * This is theirs to decide, not a moderation call: they can already remove every theme they
     * published by deleting their account, so refusing the smaller version of the same request
     * would only push somebody towards the more destructive one. It sets the status and nothing
     * else -- no reviewedAt, and no review record, because no review happened. The publisher then
     * removes the files and the record exactly as it does for a moderator withdrawal.
     */
    function validAuthorWithdrawal() {
      let before = resource.data;
      let after = request.resource.data;
      return before.ownerUid == request.auth.uid
          && before.status in ["pending", "approved", "rejected", "published"]
          && after.status == "withdrawn"
          && after.diff(before).affectedKeys().hasOnly(["status"]);
    }

    function validModeratorDecision(before, after) {
      return before.status == "pending"
          && after.status in ["approved", "rejected"]
          && changedReviewKeys(before, after);
    }

    /** Undoes an approval or a rejection while the theme is still not public. */
    function validModeratorReopen(before, after) {
      return before.status in ["approved", "rejected"]
          && after.status == "pending"
          && changedReviewKeys(before, after);
    }

    /*
     * Marks a theme for removal from the public catalogue. The status is all a client may set: the
     * files themselves live in Git, so the trusted publisher is what actually withdraws them and
     * then deletes this document.
     *
     * It accepts a still-pending submission too, and that is not the same as rejecting one. A
     * rejection is a verdict the author is meant to read; withdrawal is how a record stops
     * existing at all, which is the only answer to a submission that should not be kept on file.
     */
    function validModeratorWithdrawal(before, after) {
      return before.status in ["pending", "approved", "rejected", "published"]
          && after.status == "withdrawn"
          && changedReviewKeys(before, after);
    }

    /*
     * Corrects the public name or author credit. Deliberately limited to a submission that is not
     * public yet: an already-published file is committed to Git under the old text, and letting
     * this rewrite the record alone would leave the two disagreeing with no way to notice.
     */
    function validModeratorMetadataEdit(before, after) {
      return before.status in ["pending", "approved"]
          && after.status == before.status
          && validShortText(after.name, 48)
          && after.reviewedAt is timestamp
          && after.reviewedAt == request.time
          && after.diff(before).affectedKeys().hasOnly(["name", "reviewedAt"]);
    }

    function changedReviewKeys(before, after) {
      return after.reviewedAt is timestamp
          && after.reviewedAt == request.time
          && after.diff(before).affectedKeys().hasOnly(["status", "reviewedAt"]);
    }

    /*
     * The paired record in themeIntakeReview, verified with getAfter so the two writes must land
     * in one atomic batch. `decision` restates the status this update moved the submission to, so
     * the moderator log cannot describe an outcome the submission never reached.
     */
    function reviewRecordMatches(themeId, beforeStatus, afterStatus) {
      let review = getAfter(
        /databases/$(database)/documents/themeIntakeReview/$(themeId)
      ).data;
      return review.reviewedBy == request.auth.uid
          && review.reviewedAt == request.time
          && review.decision == afterStatus
          && review.previousStatus == beforeStatus;
    }

    function validReviewRecord() {
      let data = request.resource.data;
      return data.keys().hasOnly([
            "reviewSchemaVersion",
            "reviewedBy",
            "reviewedAt",
            "decision",
            "previousStatus",
            "shotsAccepted"
          ])
          && data.keys().hasAll([
            "reviewSchemaVersion",
            "reviewedBy",
            "reviewedAt",
            "decision",
            "previousStatus"
          ])
          /*
           * Optional, and the two lists above therefore genuinely differ -- this is not the
           * hasOnly-plus-hasAll-over-one-list pattern the intake rule avoids for costing twice
           * what a key count does.
           *
           * A moderator may approve a theme and drop its screenshot: without that, one bad image
           * forces rejecting an otherwise good theme, which is the worse outcome for everyone.
           * Absent means the same as true, so every review record written before screenshots
           * existed keeps meaning what it meant, and a decision on a theme with no image never has
           * to carry the field.
           */
          && (!data.keys().hasAny(["shotsAccepted"]) || data.shotsAccepted is bool)
          && data.reviewSchemaVersion is int
          && data.reviewSchemaVersion == 1
          && data.reviewedBy is string
          && data.reviewedBy == request.auth.uid
          && data.reviewedAt is timestamp
          && data.reviewedAt == request.time
          && data.decision in ["pending", "approved", "rejected", "withdrawn"]
          && data.previousStatus in ["pending", "approved", "rejected", "published"];
    }

    function validNewThemeIntake(themeId) {
      let data = request.resource.data;
      return validThemeId(themeId)
          // hasOnly plus an exact key count is the same contract as hasOnly plus hasAll over the
          // identical list, at roughly half the expressions. That matters here: Firestore caps a
          // request at 1000 evaluated expressions, and a submission batch writes four documents
          // whose rules all run against that single budget. Exceeding it surfaces to the client as
          // PERMISSION_DENIED, indistinguishable from a genuine rejection.
          && data.keys().hasOnly([
            "ownerUid",
            "status",
            "submissionSchemaVersion",
            "name",
            "author",
            "baseFace",
            "profileSchemaVersion",
            "revision",
            "profileJson",
            "settingsDigest",
            "moderationPreviewWebpBase64",
            "clientVersion",
            "createdAt"
          ])
          && data.keys().size() == 13
          && data.ownerUid is string
          && data.ownerUid == request.auth.uid
          && data.status == "pending"
          && data.submissionSchemaVersion is int
          && data.submissionSchemaVersion == 2
          && validShortText(data.name, 48)
          && validShortText(data.author, 48)
          && validCommunityThemeAuthorForSubmission(data.author)
          && data.baseFace is string
          // Mirrors ThemeAppearance.ALLOWED_BASE_FACES minus ArchivedFaces.KEYS. Rules cannot read
          // Kotlin, so this is a fifth hand-maintained copy of the face registry alongside the
          // constraints asset, schema.mjs and docs/admin/admin.js -- a new face must be added here
          // or every submission using it is denied by the rules while passing every local gate,
          // which the app can only report as a generic network failure. Pinned by the emulator
          // suite's per-face sweep.
          && data.baseFace in [
            "classic",
            "expressive",
            "poster",
            "studio",
            "material",
            "immersive",
            "carousel",
            "chat",
            "split",
            "note",
            "verse",
            "metadata",
            "ribbon",
            "frame"
          ]
          && data.profileSchemaVersion is int
          && data.profileSchemaVersion == 1
          && data.revision is int
          && data.revision == 1
          && data.profileJson is string
          && data.profileJson.size() >= 2
          && data.profileJson.size() <= 24576
          && data.settingsDigest is string
          && data.settingsDigest.matches('^sha256:[0-9a-f]{64}$')
          && data.moderationPreviewWebpBase64 is string
          && data.moderationPreviewWebpBase64.size() >= 4
          && data.moderationPreviewWebpBase64.size() <= 65536
          && data.moderationPreviewWebpBase64.matches('^[A-Za-z0-9+/]+={0,2}$')
          && validShortText(data.clientVersion, 64)
          && data.createdAt is timestamp
          && data.createdAt == request.time;
    }

    /*
     * The screenshot envelope. Bytes stay opaque base64 here exactly as the moderation preview
     * does: rules can bound a transport envelope and its size, and nothing more. Whether these
     * bytes are a real WebP -- and not an animation, an ICC profile or an EXIF block wearing a
     * .webp name -- is re-decided by the trusted publisher, which parses the RIFF container before
     * a byte reaches a public commit.
     *
     * 128 KB of base64 is roughly 96 KB of image, comfortably above the ~55 KB a 450x450 screenshot
     * encodes to and low enough that a stored document stays cheap.
     */
    function validNewThemeScreenshot(themeId, surface) {
      let data = request.resource.data;
      let intake = /databases/$(database)/documents/themeIntake/$(themeId);
      return surface in ["player"]
          && exists(intake)
          && get(intake).data.ownerUid == request.auth.uid
          && get(intake).data.status == "pending"
          && data.keys().hasOnly(["ownerUid", "surface", "webpBase64", "createdAt"])
          && data.keys().size() == 4
          && data.ownerUid is string
          && data.ownerUid == request.auth.uid
          && data.surface == surface
          && data.webpBase64 is string
          && data.webpBase64.size() >= 4
          && data.webpBase64.size() <= 131072
          && data.webpBase64.matches('^[A-Za-z0-9+/]+={0,2}$')
          && data.createdAt is timestamp
          && data.createdAt == request.time;
    }

    function validThemeId(themeId) {
      return themeId.matches(
        '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
      );
    }

    function validShortText(value, maximumLength) {
      return value is string && value.size() >= 1 && value.size() <= maximumLength;
    }

    function authorKeyFor(authorName) {
      return "v1:" + authorName.lower();
    }

    function validCommunityThemeAuthorName(authorName) {
      let canonical = authorName.lower();
      return validShortText(authorName, 48)
          && authorName == authorName.trim()
          && authorName == authorName.replace(' +', ' ')
          && authorName.matches("^[A-Za-z0-9]([A-Za-z0-9._' -]*[A-Za-z0-9])?$")
          && !(canonical in [
            "anonymous",
            "deleted account",
            "account-erased",
            "svartifoss"
          ]);
    }

    function validCommunityThemeAccountData(data, uid) {
      return data.keys().hasOnly([
            "ownerUid",
            "accountSchemaVersion",
            "authorName",
            "authorKey",
            "createdAt"
          ])
          && data.keys().size() == 5
          && data.ownerUid is string
          && data.ownerUid == uid
          && data.accountSchemaVersion is int
          && data.accountSchemaVersion == 1
          && validCommunityThemeAuthorName(data.authorName)
          && data.authorKey is string
          && data.authorKey == authorKeyFor(data.authorName)
          && data.createdAt is timestamp;
    }

    function validCommunityThemeAuthorNameData(data, authorKey, uid) {
      return data.keys().hasOnly([
            "ownerUid",
            "nameSchemaVersion",
            "authorName",
            "authorKey",
            "createdAt"
          ])
          && data.keys().size() == 5
          && data.ownerUid is string
          && data.ownerUid == uid
          && data.nameSchemaVersion is int
          && data.nameSchemaVersion == 1
          && validCommunityThemeAuthorName(data.authorName)
          && data.authorKey is string
          && data.authorKey == authorKey
          && authorKey == authorKeyFor(data.authorName)
          && data.createdAt is timestamp;
    }

    /*
     * Each half of the reciprocal pair fully validates *itself* and cross-checks only the other's
     * identifying fields.
     *
     * Both documents are written in the same atomic batch, so both of these rules run for every
     * first submission and each one's full shape is therefore proven exactly once. Having each
     * also re-prove the other's entire shape was pure duplicated work against the 1000-expression
     * request budget. The invariant that matters is unchanged: neither document can be created
     * without the other appearing in the same write, carrying the same owner, key and timestamp.
     *
     * The name document's own rule pins `authorKey` to its document id and to
     * `authorKeyFor(authorName)`, so agreeing on `authorKey` here is enough to agree on the name.
     */
    function validNewCommunityThemeAccount(uid) {
      let data = request.resource.data;
      let namePath = /databases/$(database)/documents/communityThemeAuthorNames/$(data.authorKey);
      return validCommunityThemeAccountData(data, uid)
          && data.createdAt == request.time
          && !exists(namePath)
          && existsAfter(namePath)
          && getAfter(namePath).data.ownerUid == uid
          && getAfter(namePath).data.authorKey == data.authorKey
          && getAfter(namePath).data.createdAt == request.time;
    }

    function validNewCommunityThemeAuthorName(authorKey) {
      let data = request.resource.data;
      let accountPath = /databases/$(database)/documents/communityThemeAccounts/$(request.auth.uid);
      return validCommunityThemeAuthorNameData(data, authorKey, request.auth.uid)
          && data.createdAt == request.time
          && !exists(accountPath)
          && existsAfter(accountPath)
          && getAfter(accountPath).data.ownerUid == request.auth.uid
          && getAfter(accountPath).data.authorKey == authorKey
          && getAfter(accountPath).data.createdAt == request.time;
    }

    /*
     * The account document is immutable: it has no update or delete rule, so once created it can
     * only ever be the one its own create rule fully validated, complete with the paired name
     * reservation that rule demanded atomically. Re-deriving both shapes on every subsequent
     * submission proved nothing new and cost the budget that made real submissions fail.
     */
    function validCommunityThemeAuthorForSubmission(author) {
      let accountPath = /databases/$(database)/documents/communityThemeAccounts/$(request.auth.uid);
      return existsAfter(accountPath)
          && getAfter(accountPath).data.ownerUid == request.auth.uid
          && (author == getAfter(accountPath).data.authorName || author == "Anonymous");
    }

    /*
     * The intake asserts only that a quota was written in *this* request and points back at this
     * exact theme. It deliberately does not re-derive the quota's shape or its rolling history:
     * that document's own create/update rule proves all of it, in this same atomic batch, and
     * duplicating the eight-key V2 shape here is what pushed an ordinary submission past
     * Firestore's 1000-expression request budget -- reported to the client as PERMISSION_DENIED
     * and shown by the app as a connection failure on a perfectly valid theme.
     *
     * `lastSubmissionAt == request.time` is what forces the write to be part of this request: an
     * already-stored quota carries an older timestamp, so an intake cannot ride along on one.
     */
    function validSubmissionQuotaForTheme(themeId) {
      let quotaPath =
        /databases/$(database)/documents/communityThemeSubmissionQuota/$(request.auth.uid);
      return existsAfter(quotaPath)
          && getAfter(quotaPath).data.lastSubmissionId == themeId
          && getAfter(quotaPath).data.lastSubmissionAt == request.time;
    }

    /*
     * Everything true of a resulting quota whether or not the account had one before.
     *
     * Both shapes are accepted, and that is a deployment property rather than indecision: an
     * installed build older than V3 still writes V2, and rules that only took V3 would not merely
     * hold such an account to the older allowance -- they would refuse its submissions outright.
     * V3 is tested first, so a current build short-circuits and never evaluates the V2 branch.
     */
    function validQuotaResult(after) {
      return (validSubmissionQuotaV3Shape(after) || validSubmissionQuotaV2Shape(after))
          && after.lastSubmissionAt == request.time
          && quotaTargetsCurrentIntake(after);
    }

    function validNewSubmissionQuota(after) {
      return after.submissionCount == 1
          && ((after.quotaSchemaVersion == 3
                && after.windowSubmissionCount == 1
                && after.windowStartedAt == request.time)
              || (after.quotaSchemaVersion == 2
                && after.recentSubmissionCount == 1
                && after.recentSubmissionFirstAt == request.time));
    }

    function validUpdatedSubmissionQuota(after) {
      let before = resource.data;
      return after.ownerUid == before.ownerUid
          && after.submissionCount == before.submissionCount + 1
          && ((validSubmissionQuotaV3Shape(before)
                && validFixedWindowProgression(before, after))
              // A V2 record moves to V3 under a current build and stays on V2 under an older one,
              // which keeps that build submitting at its own smaller allowance rather than failing.
              || (validSubmissionQuotaV2Shape(before)
                && (validRollingQuotaMigration(before, after)
                    || validRollingQuotaProgression(before, after)))
              || (validLegacySubmissionQuotaShape(before)
                && (validLegacyQuotaMigration(after)
                    || validLegacyRollingMigration(after))));
    }

    /*
     * V1 stored only the latest timestamp, which could enforce a one-per-day cooldown but could
     * not prove a three-per-rolling-window limit. V2 keeps the first and (when needed) second of
     * the last three submission timestamps. A valid V1 record may migrate exactly once on its
     * next submission; malformed records stay fail-closed and must be repaired administratively.
     */
    function validLegacySubmissionQuotaShape(data) {
      return data.keys().hasOnly([
            "ownerUid",
            "submissionCount",
            "lastSubmissionAt",
            "lastSubmissionId"
          ])
          && data.keys().size() == 4
          && data.ownerUid is string
          && data.ownerUid == request.auth.uid
          && data.submissionCount is int
          && data.submissionCount >= 1
          && data.lastSubmissionAt is timestamp
          && data.lastSubmissionId is string
          && validThemeId(data.lastSubmissionId);
    }

    function validSubmissionQuotaV2Shape(data) {
      return data.keys().hasOnly([
            "ownerUid",
            "quotaSchemaVersion",
            "submissionCount",
            "lastSubmissionAt",
            "lastSubmissionId",
            "recentSubmissionCount",
            "recentSubmissionFirstAt",
            "recentSubmissionSecondAt"
          ])
          && data.ownerUid is string
          && data.ownerUid == request.auth.uid
          && data.quotaSchemaVersion is int
          && data.quotaSchemaVersion == 2
          && data.submissionCount is int
          && data.submissionCount >= 1
          && data.lastSubmissionAt is timestamp
          && data.lastSubmissionId is string
          && validThemeId(data.lastSubmissionId)
          && data.recentSubmissionCount is int
          && data.recentSubmissionCount in [1, 2, 3]
          && data.submissionCount >= data.recentSubmissionCount
          && data.recentSubmissionFirstAt is timestamp
          // The seven required keys are already pinned present by the `is` checks above, and
          // hasOnly bounds the set to eight, so each branch only has to settle whether the
          // optional eighth is there -- an exact size does that and replaces a second key list.
          && ((data.recentSubmissionCount == 1
                && data.keys().size() == 7
                && data.recentSubmissionFirstAt == data.lastSubmissionAt)
              || (data.recentSubmissionCount == 2
                && data.keys().size() == 7
                && data.recentSubmissionFirstAt <= data.lastSubmissionAt)
              || (data.recentSubmissionCount == 3
                && data.keys().size() == 8
                && data.recentSubmissionSecondAt is timestamp
                && data.recentSubmissionFirstAt <= data.recentSubmissionSecondAt
                && data.recentSubmissionSecondAt <= data.lastSubmissionAt));
    }

    /*
     * V3: a fixed 24-hour window, two scalars instead of a hand-unrolled ring of timestamps.
     *
     * V2 proved "at most N in any *rolling* 24 hours" by storing the timestamp of every one of the
     * last N submissions, which is why N was 3: each extra slot is another stored timestamp and
     * another branch of the progression rule, inside the four-document submission batch whose
     * 1000-expression budget is already the sharp edge of this path. Raising the allowance to ten
     * that way would have meant nine timestamp fields and ten branches.
     *
     * A fixed window costs the same at any N: a window start and a count within it. What it gives
     * up is the boundary -- ten submissions late in one window and ten early in the next is a burst
     * of twenty in minutes. That is accepted deliberately: this is a spam brake, the moderation
     * queue is the actual gate, and twenty themes is still twenty a human must look at.
     */
    function validSubmissionQuotaV3Shape(data) {
      return data.keys().hasOnly([
            "ownerUid",
            "quotaSchemaVersion",
            "submissionCount",
            "lastSubmissionAt",
            "lastSubmissionId",
            "windowStartedAt",
            "windowSubmissionCount"
          ])
          && data.keys().size() == 7
          && data.ownerUid is string
          && data.ownerUid == request.auth.uid
          && data.quotaSchemaVersion is int
          && data.quotaSchemaVersion == 3
          && data.submissionCount is int
          && data.submissionCount >= 1
          && data.lastSubmissionAt is timestamp
          && data.lastSubmissionId is string
          && validThemeId(data.lastSubmissionId)
          && data.windowStartedAt is timestamp
          && data.windowSubmissionCount is int
          // The allowance itself, stated once. A progression that would exceed it produces a
          // document this shape refuses, so no branch below has to repeat the number.
          && data.windowSubmissionCount >= 1
          && data.windowSubmissionCount <= 10
          && data.submissionCount >= data.windowSubmissionCount
          && data.windowStartedAt <= data.lastSubmissionAt;
    }

    /* Shape, owner, count, timestamp and intake pairing are asserted by the caller. */
    function validLegacyQuotaMigration(after) {
      return after.quotaSchemaVersion == 3
          && after.windowSubmissionCount == 1
          && after.windowStartedAt == request.time;
    }

    /* The same one-off V1 migration performed by a build that still writes V2. */
    function validLegacyRollingMigration(after) {
      return after.quotaSchemaVersion == 2
          && after.recentSubmissionCount == 1
          && after.recentSubmissionFirstAt == request.time;
    }

    /*
     * Retained for a build that has not yet moved to the fixed window. It is what bounded V2 to
     * three per *rolling* 24 hours: the timestamp of every submission still inside the window had
     * to be stored, so each extra one cost a field here and a branch below. That is the cost V3
     * stops paying, and the reason the allowance could be raised at all.
     */
    function validRollingQuotaProgression(before, after) {
      return ((before.recentSubmissionCount == 1
                && after.recentSubmissionCount == 2
                && after.recentSubmissionFirstAt == before.recentSubmissionFirstAt)
              || (before.recentSubmissionCount == 2
                && after.recentSubmissionCount == 3
                && after.recentSubmissionFirstAt == before.recentSubmissionFirstAt
                && after.recentSubmissionSecondAt == before.lastSubmissionAt)
              || (before.recentSubmissionCount == 3
                && request.time >= before.recentSubmissionFirstAt + duration.value(24, 'h')
                && after.recentSubmissionCount == 3
                && after.recentSubmissionFirstAt == before.recentSubmissionSecondAt
                && after.recentSubmissionSecondAt == before.lastSubmissionAt));
    }

    /*
     * V2 records carry a real window, so migrating must not hand back a fresh allowance: the new
     * window opens at the oldest submission V2 still remembers and inherits its count. Only once
     * that timestamp is itself a day old does the migration start a window at `now`.
     */
    function validRollingQuotaMigration(before, after) {
      return after.quotaSchemaVersion == 3
          && ((request.time >= before.recentSubmissionFirstAt + duration.value(24, 'h')
                && after.windowStartedAt == request.time
                && after.windowSubmissionCount == 1)
              || (after.windowStartedAt == before.recentSubmissionFirstAt
                && after.windowSubmissionCount == before.recentSubmissionCount + 1));
    }

    function validFixedWindowProgression(before, after) {
      return (after.windowStartedAt == before.windowStartedAt
                && after.windowSubmissionCount == before.windowSubmissionCount + 1)
          || (request.time >= before.windowStartedAt + duration.value(24, 'h')
                && after.windowStartedAt == request.time
                && after.windowSubmissionCount == 1);
    }

    function quotaTargetsCurrentIntake(quota) {
      let submissionId = quota.lastSubmissionId;
      let intake = getAfter(
        /databases/$(database)/documents/themeIntake/$(submissionId)
      ).data;
      return !exists(
            /databases/$(database)/documents/themeIntake/$(submissionId)
          )
          && intake.ownerUid == request.auth.uid
          && intake.status == "pending"
          && intake.createdAt == request.time;
    }
  }
}
