<?xml version="1.0" encoding="utf-8"?>
<!-- Shared geometry for the animated three-bar music indicator. The phone uses it for loading
     states and the watch uses it for now-playing surfaces. Bars are fully rounded capsules and
     are drawn at full height; their groups pivot just below the bottom edge so scaleY animation
     makes each bar grow upward. The initial scales leave a useful static pose when animation is
     unavailable or stopped. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:name="bar1_group"
        android:pivotX="7"
        android:pivotY="20"
        android:scaleY="0.35">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M5.5,5.5 A1.5,1.5 0 0 1 8.5,5.5 L8.5,18.5 A1.5,1.5 0 0 1 5.5,18.5 Z" />
    </group>
    <group
        android:name="bar2_group"
        android:pivotX="12"
        android:pivotY="20"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.5,5.5 A1.5,1.5 0 0 1 13.5,5.5 L13.5,18.5 A1.5,1.5 0 0 1 10.5,18.5 Z" />
    </group>
    <group
        android:name="bar3_group"
        android:pivotX="17"
        android:pivotY="20"
        android:scaleY="0.45">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15.5,5.5 A1.5,1.5 0 0 1 18.5,5.5 L18.5,18.5 A1.5,1.5 0 0 1 15.5,18.5 Z" />
    </group>
</vector>
