<?xml version="1.0" encoding="utf-8"?>

<!-- Landscape keeps the explanatory quick-panel card in a narrow, independently scrollable
     column and gives the ordered action list the full height of the wider column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:text="@string/actions_intro"
                android:textColor="@color/lyra_pref_summary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:letterSpacing="0.1"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="2dp"
                android:text="@string/actions_quick_panel_section"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/quick_panel_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_gamepad"
                    android:tint="@color/lyra_text_secondary"
                    tools:ignore="ContentDescription,UseAppTint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:text="@string/quick_panel_row_title"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/quick_panel_row_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/google_sans"
                        android:textColor="@color/lyra_pref_summary"
                        android:textSize="12sp"
                        tools:text="Like · Shuffle · Repeat · Up Next" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/lyra_text_secondary"
                    tools:ignore="ContentDescription,UseAppTint" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/lyra_divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:letterSpacing="0.1"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:text="@string/actions_watch_menu_section"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/action_list_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="12sp"
            tools:text="8 actions · Tap to edit · Hold and drag to reorder" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/actions_reorder_description" />

            <TextView
                android:id="@+id/action_list_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/google_sans"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/actions_empty"
                android:textColor="@color/lyra_pref_summary"
                android:textSize="14sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
