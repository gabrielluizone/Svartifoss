<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingTop="16dp"
        android:paddingRight="@dimen/activity_horizontal_margin"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:context=".view.mainactivity.MainActivity"
        tools:minHeight="400dp"
        tools:showIn="@layout/app_bar_main">

        <TextView
            android:id="@+id/on_screen_buttons_caption"
            style="@style/TextAppearance.AppCompat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/google_sans"
            android:letterSpacing="0.08"
            android:text="@string/on_screen_buttons"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/on_screen_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/google_sans"
            android:maxLines="2"
            android:text="@string/tap_a_zone_to_configure"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/watch_display_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/on_screen_buttons_caption" />

        <ImageView
            android:id="@+id/watch_display_background"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/watch_round_background"
            app:layout_constraintBottom_toBottomOf="@+id/four_way_touch"
            app:layout_constraintEnd_toEndOf="@+id/four_way_touch"
            app:layout_constraintStart_toStartOf="@+id/four_way_touch"
            app:layout_constraintTop_toTopOf="@+id/four_way_touch"
            tools:ignore="ContentDescription" />

        <com.svartifoss.snfell.common.view.FourWayTouchLayout
            android:id="@+id/four_way_touch"
            android:layout_width="205dp"
            android:layout_height="205dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@+id/icon_bottom"
            app:layout_constraintEnd_toEndOf="@+id/icon_right"
            app:layout_constraintStart_toStartOf="@+id/icon_left"
            app:layout_constraintTop_toTopOf="@+id/icon_top" />

        <ImageView
            android:id="@+id/watch_display_border"
            android:layout_width="205dp"
            android:layout_height="205dp"
            android:src="@drawable/watch_round_border"
            app:layout_constraintBottom_toBottomOf="@+id/four_way_touch"
            app:layout_constraintEnd_toEndOf="@+id/four_way_touch"
            app:layout_constraintStart_toStartOf="@+id/four_way_touch"
            app:layout_constraintTop_toTopOf="@+id/four_way_touch"
            tools:ignore="ContentDescription" />


        <ImageView
            android:id="@+id/icon_left"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="24dp"
            android:adjustViewBounds="false"
            android:padding="10dp"
            android:src="@drawable/action_pause"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/space4"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/icon_top"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:padding="10dp"
            android:src="@drawable/action_volume_up"
            app:layout_constraintStart_toStartOf="@+id/space4"
            app:layout_constraintTop_toBottomOf="@+id/on_screen_hint"
            app:layout_constraintVertical_chainStyle="packed"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/icon_right"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="10dp"
            android:src="@drawable/action_skip_next"
            app:layout_constraintStart_toEndOf="@+id/space4"
            app:layout_constraintTop_toTopOf="@+id/space4"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/icon_bottom"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:padding="10dp"
            android:src="@drawable/action_volume_down"
            app:layout_constraintStart_toStartOf="@+id/space4"
            app:layout_constraintTop_toBottomOf="@+id/space4"
            tools:ignore="ContentDescription" />

        <Space
            android:id="@+id/space4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintStart_toEndOf="@+id/icon_left"
            app:layout_constraintTop_toBottomOf="@+id/icon_top" />

        <!-- Center zone icon: the watch's hidden center-tap gesture, made visible/configurable
             (single tap only - double tap/long press stay the fixed quick-panel/queue behavior) -->
        <ImageView
            android:id="@+id/icon_center"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/center_button_bg"
            android:padding="10dp"
            android:src="@drawable/action_play_pause"
            app:layout_constraintBottom_toBottomOf="@+id/space4"
            app:layout_constraintEnd_toEndOf="@+id/space4"
            app:layout_constraintStart_toStartOf="@+id/space4"
            app:layout_constraintTop_toTopOf="@+id/space4"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/caption_physical_buttons"
            style="@style/TextAppearance.AppCompat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/google_sans"
            android:letterSpacing="0.08"
            android:text="@string/physical_buttons"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/physical_buttons_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/physical_buttons_disconnected"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/watch_display_border"
            app:layout_constraintTop_toBottomOf="@+id/caption_physical_buttons" />

        <LinearLayout
            android:id="@+id/watch_button_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/caption_physical_buttons"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/watch_display_border"
            app:layout_constraintTop_toBottomOf="@+id/physical_buttons_hint" />

        <TextView
            android:id="@+id/swipe_gestures_caption"
            style="@style/TextAppearance.AppCompat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/google_sans"
            android:letterSpacing="0.08"
            android:text="@string/swipe_gestures"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/watch_button_container" />

        <TextView
            android:id="@+id/swipe_gestures_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/tap_a_swipe_to_configure"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/swipe_gestures_caption" />

        <LinearLayout
            android:id="@+id/swipe_gesture_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/swipe_gestures_hint" />

        <TextView
            android:id="@+id/screen_buttons_caption"
            style="@style/TextAppearance.AppCompat.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/google_sans"
            android:letterSpacing="0.08"
            android:text="@string/screen_buttons"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/swipe_gesture_container" />

        <TextView
            android:id="@+id/screen_buttons_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/tap_a_screen_button_to_configure"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/screen_buttons_caption" />

        <LinearLayout
            android:id="@+id/screen_button_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/screen_buttons_hint" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
