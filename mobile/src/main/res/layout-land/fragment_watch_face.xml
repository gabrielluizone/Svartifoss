<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape twin of layout/fragment_watch_face.xml, with the same ids: the preview and its
     caption on the left, and Home or one area's editor filling the rest of the width. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Width is resized together with the preview at runtime, keeping the watch large while the
         preferences retain the rest of the landscape width. -->
    <LinearLayout
        android:id="@+id/watch_preview_panel"
        android:layout_width="176dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.svartifoss.snfell.view.watchface.WatchPreviewView
            android:id="@+id/watch_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/watch_preview_description"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/watch_preview_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/lyra_on_surface"
            android:textSize="13sp"
            tools:text="Studio · Volume" />

    </LinearLayout>

    <View
        android:id="@+id/watch_preview_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/lyra_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/watch_preview_panel"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/watch_home_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/watch_preview_divider"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/watch_editor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/watch_preview_divider"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/lyra_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/watch_editor_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/lyra_on_surface"
                tools:ignore="UseAppTint" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/watch_tabs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/lyra_background"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/lyra_accent"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabRippleColor="@color/lyra_ripple"
                app:tabSelectedTextColor="@color/lyra_accent"
                app:tabSelectedTextAppearance="@style/LyraTabText"
                app:tabTextAppearance="@style/LyraTabText"
                app:tabTextColor="@color/lyra_text_secondary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lyra_divider" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/watch_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
