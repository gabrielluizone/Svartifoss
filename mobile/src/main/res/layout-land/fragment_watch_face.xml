<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Width is resized together with the preview at runtime, keeping the watch large while the
         preferences retain the rest of the landscape width. -->
    <FrameLayout
        android:id="@+id/watch_preview_panel"
        android:layout_width="176dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.svartifoss.snfell.view.watchface.WatchPreviewView
            android:id="@+id/watch_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="@string/watch_preview_description"
            android:importantForAccessibility="yes" />

    </FrameLayout>

    <View
        android:id="@+id/watch_preview_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/lyra_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/watch_preview_panel"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/watch_preview_divider"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/watch_theme_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            app:cardBackgroundColor="@color/lyra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:id="@+id/watch_theme_icon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/circle_icon_bg"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_palette"
                    android:tint="@color/lyra_accent"
                    tools:ignore="UseAppTint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/watch_theme_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/lyra_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Midnight Poster" />

                    <TextView
                        android:id="@+id/watch_theme_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/lyra_text_secondary"
                        android:textSize="11sp"
                        tools:text="Custom theme • Poster layout" />

                </LinearLayout>

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/lyra_text_secondary"
                    tools:ignore="UseAppTint" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/watch_tabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/lyra_background"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/lyra_accent"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabRippleColor="@color/lyra_ripple"
            app:tabSelectedTextColor="@color/lyra_accent"
            app:tabSelectedTextAppearance="@style/LyraTabText"
            app:tabTextAppearance="@style/LyraTabText"
            app:tabTextColor="@color/lyra_text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lyra_divider" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/watch_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
