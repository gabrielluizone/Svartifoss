<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidElementNotAllowed -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Shown/hidden programmatically (see MiscSettingsFragment.updateNoWatchBannerVisibility)
         depending on whether a watch is currently paired/connected - everything below still
         works and stays configurable either way, this is just a heads-up that watch-facing
         settings won't visibly apply until a watch connects. -->
    <Preference
        android:key="no_watch_banner"
        android:icon="@drawable/ic_watch_off"
        android:title="@string/setting_no_watch_banner"
        android:summary="@string/setting_no_watch_banner_description"
        android:selectable="false"
        android:visible="false"
        android:layout="@layout/pref_item" />

    <!-- Kept first: the only category that ever needs urgent attention (a pending release), so
         it shouldn't be buried below everything else. -->
    <PreferenceCategory
        android:key="cat_updates"
        android:title="@string/category_updates"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="update_check_now"
            android:icon="@drawable/ic_autorenew"
            android:title="@string/setting_update_check_now"
            android:summary="@string/setting_update_check_now_description"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:key="update_check_enabled"
            android:icon="@drawable/ic_bell"
            android:defaultValue="true"
            android:title="@string/setting_update_check"
            android:summary="@string/setting_update_check_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:key="update_include_prereleases"
            android:defaultValue="false"
            android:title="@string/setting_update_prereleases"
            android:summary="@string/setting_update_prereleases_description"
            android:dependency="update_check_enabled"
            android:layout="@layout/pref_switch_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_appearance"
        android:title="@string/category_appearance"
        android:layout="@layout/pref_category_header">

        <ListPreference
            android:key="app_theme"
            android:icon="@drawable/ic_dark_mode"
            android:title="@string/setting_theme"
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_entry_values"
            android:summary="%s"
            android:layout="@layout/pref_item" />

        <!-- Synced to the watch (it is in MiscPreferences.EXPORTABLE), so both apps follow one
             choice instead of each following its own device locale. -->
        <ListPreference
            android:key="app_language"
            android:icon="@drawable/ic_language"
            android:title="@string/setting_language"
            android:defaultValue="system"
            android:entries="@array/app_language_entries"
            android:entryValues="@array/app_language_values"
            android:summary="%s"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:key="dynamic_accent_color"
            android:icon="@drawable/ic_colors"
            android:defaultValue="true"
            android:title="@string/setting_dynamic_accent_color"
            android:summary="@string/setting_dynamic_accent_color_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:key="desaturated_color"
            android:defaultValue="true"
            android:title="@string/setting_desaturated_color"
            android:summary="@string/setting_desaturated_color_description"
            android:dependency="dynamic_accent_color"
            android:layout="@layout/pref_switch_item" />

        <com.svartifoss.snfell.view.settings.ColorDotPreference
            android:key="custom_accent_color"
            android:icon="@drawable/ic_palette"
            android:title="@string/setting_custom_accent_color"
            android:summary="@string/setting_custom_accent_color_description"
            android:layout="@layout/pref_item"
            android:widgetLayout="@layout/pref_widget_color_dot" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:key="mini_player_enabled"
            android:icon="@drawable/ic_player_theme"
            android:defaultValue="true"
            android:title="@string/setting_mini_player"
            android:summary="@string/setting_mini_player_description"
            android:layout="@layout/pref_switch_item" />

    </PreferenceCategory>

    <!-- What the watch's now-playing screen LOOKS like (face, themes, album background,
         colors, mini-button appearance) moved to the "Watch face" tab - see
         watch_face_settings.xml / WatchFacePrefsFragment. This screen keeps behavior. -->

    <!-- Touch, crown and button behavior on the watch. -->
    <PreferenceCategory
        android:key="cat_gestures"
        android:title="@string/category_gestures"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="swipe_gestures_hint"
            android:icon="@drawable/ic_swipe_directions"
            android:title="@string/setting_swipe_gestures_hint"
            android:summary="@string/setting_swipe_gestures_hint_description"
            android:layout="@layout/pref_item" />

        <!-- Replaces the wear_center_long_press_queue switch, which is still read as the fallback
             for anyone who had turned it on - see CenterLongPressAction.resolve. -->
        <ListPreference
            android:defaultValue="faces"
            android:key="wear_center_long_press"
            android:icon="@drawable/ic_playlist_play"
            android:title="@string/setting_wear_center_long_press"
            android:summary="%s"
            android:entries="@array/wear_center_long_press_entries"
            android:entryValues="@array/wear_center_long_press_values"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="300"
            android:key="rotating_crown_off_period"
            android:icon="@drawable/button_turn_ccw"
            android:title="@string/setting_rotating_crown_off_period"
            android:summary="@string/setting_rotating_crown_off_period_description"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="40"
            android:key="rotating_crown_sensitivity"
            android:icon="@drawable/ic_tune"
            android:title="@string/setting_rotating_sensitivity"
            android:summary="@string/setting_rotating_sensitivity_description"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="6"
            android:key="rotary_deadzone"
            android:icon="@drawable/ic_tune"
            android:title="@string/setting_rotary_deadzone"
            android:summary="@string/setting_rotary_deadzone_description"
            android:layout="@layout/pref_item" />

        <ListPreference
            android:defaultValue="volume"
            android:key="wear_rotary_action"
            android:icon="@drawable/ic_progress_style"
            android:title="@string/setting_wear_rotary_action"
            android:summary="%s"
            android:entries="@array/wear_rotary_action_entries"
            android:entryValues="@array/wear_rotary_action_values"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="1000"
            android:key="volume_overlay_timeout"
            android:icon="@drawable/action_volume_up"
            android:title="@string/setting_volume_overlay_timeout"
            android:summary="@string/setting_volume_overlay_timeout_description"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="disable_ambient_physical_double_click"
            android:icon="@drawable/ic_watch_off"
            android:title="@string/setting_disable_ambient_physical_double_click"
            android:summary="@string/setting_disable_ambient_physical_double_click_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="haptic_feedback"
            android:icon="@drawable/ic_watch_vibration"
            android:title="@string/setting_haptic_feedback"
            android:summary="@string/setting_haptic_feedback_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="pause_on_swipe_exit"
            android:icon="@drawable/ic_pause"
            android:title="@string/setting_pause_on_swipe_exit"
            android:summary="@string/setting_pause_on_swipe_exit_description"
            android:layout="@layout/pref_switch_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_action_list"
        android:title="@string/category_action_list"
        android:layout="@layout/pref_category_header">

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="always_select_center_action"
            android:icon="@drawable/ic_joystick"
            android:title="@string/setting_always_select_center_action"
            android:summary="@string/setting_always_select_center_action_description"
            android:layout="@layout/pref_switch_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_notifications"
        android:title="@string/category_notifications"
        android:layout="@layout/pref_category_header">

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="enable_notification_popup"
            android:icon="@drawable/ic_bell"
            android:title="@string/setting_enable_notifications"
            android:summary="@string/setting_enable_notifications_description"
            android:layout="@layout/pref_switch_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="10"
            android:key="notification_timeout"
            android:icon="@drawable/ic_history"
            android:dependency="enable_notification_popup"
            android:title="@string/setting_notification_timeout"
            android:summary="@string/setting_notification_timeout_description"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_apps"
        android:title="@string/category_music_apps"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="apps_integrations_info"
            android:icon="@drawable/ic_apps"
            android:title="@string/setting_apps_integrations"
            android:summary="@string/setting_apps_integrations_description"
            android:selectable="false"
            android:layout="@layout/pref_item" />

        <!-- One of the app's few network paths - kept beside the other two so they are read
             together. On by default, unlike the shortcut-artwork fetch: a lyric has no second
             source, so off does not degrade the screen, it empties it. Nothing is requested until
             the watch's lyrics screen is opened. Keep docs/privacy-policy.md in step. -->
        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="lyrics_enabled"
            android:icon="@drawable/action_lyrics"
            android:title="@string/setting_lyrics_enabled"
            android:summary="@string/setting_lyrics_enabled_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="metadata_lookup_enabled"
            android:icon="@drawable/ic_newsmode"
            android:title="@string/setting_metadata_lookup"
            android:summary="@string/setting_metadata_lookup_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.AutoSummaryListPreference
            android:key="streaming_open_mode"
            android:icon="@drawable/ic_apps"
            android:title="@string/setting_streaming_open_mode"
            android:entries="@array/streaming_open_mode_entries"
            android:entryValues="@array/streaming_open_mode_values"
            app:summary="%1$s"
            app:defaultValue="app"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="playlist_shortcuts"
            android:icon="@drawable/ic_playlist_add"
            android:title="@string/setting_playlist_shortcuts"
            android:summary="@string/setting_playlist_shortcuts_description"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="false"
            android:key="streaming_shortcut_artwork"
            android:icon="@drawable/ic_album"
            android:title="@string/setting_shortcut_artwork"
            android:summary="@string/setting_shortcut_artwork_description"
            android:layout="@layout/pref_switch_item" />

        <Preference
            android:key="queue_media_permission"
            android:icon="@drawable/ic_album"
            android:title="@string/setting_queue_local_artwork"
            android:summary="@string/setting_queue_local_artwork_description"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="queue_remote_artwork"
            android:icon="@drawable/ic_album"
            android:title="@string/setting_queue_remote_artwork"
            android:summary="@string/setting_queue_remote_artwork_description"
            android:layout="@layout/pref_switch_item" />

        <Preference
            android:key="notification_access"
            android:icon="@drawable/ic_bell"
            android:title="@string/setting_notification_access"
            android:summary="@string/setting_notification_access_disabled"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="persistent_notification_settings"
            android:icon="@drawable/ic_tune"
            android:title="@string/setting_persistent_notification"
            android:summary="@string/setting_persistent_notification_description"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.MusicAppListPreference
            android:key="auto_start_apps_blacklist"
            android:icon="@drawable/ic_apps"
            android:title="@string/setting_auto_start_apps_blacklist"
            android:summary="@string/setting_auto_start_apps_blacklist_description"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_automation"
        android:title="@string/category_automation"
        android:layout="@layout/pref_category_header">

        <com.matejdro.wearutils.preferences.compat.AutoSummaryListPreference
            android:key="auto_start_mode"
            android:icon="@drawable/action_play"
            android:entryValues="@array/auto_start_modes_keys"
            android:entries="@array/auto_start_modes_descriptions"
            android:title="@string/setting_auto_start"
            app:summary="%1$s"
            app:defaultValue="OFF"
            android:layout="@layout/pref_item" />

        <com.svartifoss.snfell.view.settings.ResettableNumericEditTextPreference
            android:defaultValue="0"
            android:key="close_timeout"
            android:icon="@drawable/ic_history"
            android:title="@string/setting_close_timeout"
            android:summary="@string/setting_close_timeout_description"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="wear_close_on_idle"
            android:icon="@drawable/ic_history"
            android:title="@string/setting_wear_close_on_idle"
            android:summary="@string/setting_wear_close_on_idle_description"
            android:layout="@layout/pref_switch_item" />

        <ListPreference
            android:defaultValue="30"
            android:key="wear_paused_hold"
            android:icon="@drawable/action_play_pause"
            android:title="@string/setting_wear_paused_hold"
            android:dialogMessage="@string/setting_wear_paused_hold_description"
            android:summary="%s"
            android:entries="@array/wear_paused_hold_entries"
            android:entryValues="@array/wear_paused_hold_values"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

    <!-- What the watch offers when there is no session at all. Behaviour rather than looks, so it
         belongs here and not in the Watch face tab: these pick which *screen* the idle state leads
         to, using destinations (menu, shortcuts, search, queue) that already existed but that the
         idle screen never exposed. -->
    <PreferenceCategory
        android:key="cat_idle"
        android:title="@string/category_idle"
        android:layout="@layout/pref_category_header">

        <ListPreference
            android:defaultValue="none"
            android:key="wear_idle_button_action"
            android:icon="@drawable/action_play"
            android:title="@string/setting_wear_idle_button_action"
            android:summary="%s"
            android:entries="@array/wear_idle_button_action_entries"
            android:entryValues="@array/wear_idle_button_action_values"
            android:layout="@layout/pref_item" />

        <ListPreference
            android:defaultValue="none"
            android:key="wear_idle_auto_open"
            android:icon="@drawable/ic_playlist_play"
            android:title="@string/setting_wear_idle_auto_open"
            android:dialogMessage="@string/setting_wear_idle_auto_open_description"
            android:summary="%s"
            android:entries="@array/wear_idle_auto_open_entries"
            android:entryValues="@array/wear_idle_auto_open_values"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>


    <PreferenceCategory
        android:key="cat_backup"
        android:title="@string/category_backup"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="exportConfig"
            android:icon="@drawable/ic_export"
            android:title="@string/export_config"
            android:summary="@string/export_config_description"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="importConfig"
            android:icon="@drawable/ic_import"
            android:title="@string/import_config"
            android:summary="@string/import_config_description"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_privacy"
        android:title="@string/category_privacy"
        android:layout="@layout/pref_category_header">

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="crash_reporting_enabled"
            android:icon="@drawable/ic_bug_report"
            android:title="@string/setting_crash_reporting"
            android:summary="@string/setting_crash_reporting_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="announcements_enabled"
            android:icon="@drawable/ic_notification_brand"
            android:title="@string/setting_announcements"
            android:summary="@string/setting_announcements_description"
            android:layout="@layout/pref_switch_item" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="cat_about"
        android:title="@string/category_about"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="version"
            android:icon="@drawable/ic_app_brand"
            android:title="@string/installed_version"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="supportButton"
            android:icon="@drawable/ic_help"
            android:summary="@string/get_support_description"
            android:title="@string/get_support"
            android:layout="@layout/pref_item" />

        <!-- Summary is the literal address so it is readable (and long-press copyable) without
             needing an email client installed. -->
        <Preference
            android:key="contactDeveloper"
            android:icon="@drawable/ic_email"
            android:title="@string/contact_developer"
            android:summary="@string/contact_developer_email"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="aboutDeveloper"
            android:icon="@drawable/ic_person"
            android:title="@string/about_developer_title"
            android:summary="@string/about_developer_summary"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="developerGithub"
            android:icon="@drawable/ic_link"
            android:title="@string/about_developer_github"
            android:summary="@string/about_developer_handle"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="licenses"
            android:icon="@drawable/ic_open_in_new"
            android:title="@string/licenses"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

    <!-- Visível apenas após 7 cliques na versão -->
    <PreferenceCategory
        android:key="cat_developer"
        android:title="@string/category_developer"
        android:visible="false"
        android:layout="@layout/pref_category_header">

        <Preference
            android:key="dev_build_info"
            android:icon="@drawable/ic_bug_report"
            android:title="@string/dev_build_info"
            android:layout="@layout/pref_item" />


        <Preference
            android:key="dev_sync_watch"
            android:icon="@drawable/ic_sync_to_watch"
            android:title="@string/dev_sync_watch"
            android:summary="@string/dev_sync_watch_description"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="dev_copy_debug_info"
            android:icon="@drawable/ic_share"
            android:title="@string/dev_copy_debug_info"
            android:summary="@string/dev_copy_debug_info_description"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="dev_open_update_screen"
            android:icon="@drawable/ic_autorenew"
            android:title="@string/dev_open_update_screen"
            android:summary="@string/dev_open_update_screen_description"
            android:layout="@layout/pref_item" />

        <SwitchPreferenceCompat
            android:key="dev_show_archived"
            android:defaultValue="false"
            android:icon="@drawable/ic_archived_options"
            android:title="@string/dev_show_archived"
            android:summary="@string/dev_show_archived_description"
            android:layout="@layout/pref_item" />

        <SwitchPreferenceCompat
            android:key="wear_dev_show_layout_bounds"
            android:defaultValue="false"
            android:icon="@drawable/ic_rounded_corner"
            android:title="@string/dev_watch_layout_bounds"
            android:summary="@string/dev_watch_layout_bounds_description"
            android:layout="@layout/pref_item" />

        <SwitchPreferenceCompat
            android:key="wear_dev_show_player_info"
            android:defaultValue="false"
            android:icon="@drawable/ic_text_fields"
            android:title="@string/dev_watch_player_info"
            android:summary="@string/dev_watch_player_info_description"
            android:layout="@layout/pref_item" />

        <Preference
            android:key="dev_disable_mode"
            android:icon="@drawable/ic_toggle_off"
            android:title="@string/dev_disable_mode"
            android:summary="@string/dev_disable_mode_description"
            android:layout="@layout/pref_item" />

    </PreferenceCategory>

</PreferenceScreen>
