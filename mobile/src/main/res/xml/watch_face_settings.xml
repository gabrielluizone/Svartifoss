            android:key="wear_edge_progress_visible"
            android:icon="@drawable/ic_progress_ring"
            android:title="@string/setting_wear_edge_progress_visible"
            android:summary="@string/setting_wear_edge_progress_visible_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="wear_edge_seek_enabled"
            android:icon="@drawable/ic_progress_style"
