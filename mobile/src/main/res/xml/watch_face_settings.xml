<?xml version="1.0" encoding="utf-8"?><!--suppress AndroidElementNotAllowed -->
<!-- The watch appearance screen: everything that changes how the watch UI looks. WatchPreviewView
     follows the active section and focused preference across the player, AOD and secondary
     surfaces. Behavior settings stay in Settings. All keys here were moved from settings.xml;
     they are the same MiscPreferences the watch already syncs and the config backup exports. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="cat_wf_face"
        android:title="@string/category_screen_face"
        android:layout="@layout/pref_category_header">

        <ListPreference
            android:key="wear_screen_face"
            android:icon="@drawable/ic_player_theme"
            android:defaultValue="classic"
            android:title="@string/setting_wear_screen_face"
            android:summary="@string/setting_wear_screen_face_description"
            android:entries="@array/wear_screen_face_entries"
            android:entryValues="@array/wear_screen_face_values"
            android:layout="@layout/pref_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
            android:defaultValue="true"
            android:key="wear_show_track_title"
            android:icon="@drawable/ic_music_note"
            android:title="@string/setting_wear_show_track_title"
            android:summary="@string/setting_wear_show_track_title_description"
            android:layout="@layout/pref_switch_item" />

        <com.matejdro.wearutils.preferences.compat.SwitchPreferenceEx
