    <string name="community_theme_submit_author">اسم المؤلف العام</string>
    <string name="community_theme_submit_author_helper">اختر مرة واحدة: A–Z و0–9 والمسافات والنقطة والشرطة السفلية والفاصلة العليا أو الواصلة. الاسم فريد ويبقى ثابتًا حتى تحذف الحساب.</string>
