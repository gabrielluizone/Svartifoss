<?xml version="1.0" encoding="utf-8"?>
<!-- The outlined, rounded surface of a "choice" row in a sheet: same card language as the saved
     shortcut rows (surface fill, 1dp divider stroke, 18dp corners). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/lyra_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/lyra_divider" />
    <corners android:radius="18dp" />
</shape>
