<?xml version="1.0" encoding="utf-8"?>
<!-- The empty attach slot: a dashed circle, so its shape already says what will land in it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/lyra_background" />
    <stroke
        android:width="1dp"
        android:color="@color/lyra_divider"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
</shape>
