<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Shown/hidden at runtime (see MainActivity.onPrepareOptionsMenu) whenever a checked
         release is newer than what's installed - a nudge for someone who dismissed or missed the
         one-shot update notification. Tapping it opens the Updates screen directly. -->
    <item
        android:id="@+id/menu_update_available"
        android:icon="@drawable/ic_update_available"
        android:title="@string/update_available_action"
        android:visible="false"
        app:showAsAction="always" />

    <!-- Shown only on the two preference tabs (see MainActivity.onPrepareOptionsMenu): it searches
         settings, so offering it from Controls or Actions would promise more than it does. -->
    <item
        android:id="@+id/menu_search_settings"
        android:icon="@drawable/ic_search"
        android:title="@string/settings_search_title"
        android:visible="false"
        app:showAsAction="always" />

    <!-- The community gallery. Always available: it is a destination rather than a control for
         whatever tab is showing, and a shortcut that appears on some tabs and not others is one
         nobody learns. The shopping-bag glyph is the same one the Watch themes screen's own row
         carries - a palette would read as "customize the look" rather than "browse what other
         people published", and one glyph should keep one meaning. -->
    <item
        android:id="@+id/menu_community_themes"
        android:icon="@drawable/ic_shopping_bag"
        android:title="@string/online_themes_title"
        app:showAsAction="always" />

    <!-- The usage guide, formerly the "Guide" bottom-nav tab - its slot now hosts the watch
         face customization screen, so the guide moved up here as a help action. -->
    <item
        android:id="@+id/menu_help"
        android:icon="@drawable/ic_help"
        android:title="@string/tutorial_header"
        app:showAsAction="always" />

</menu>
