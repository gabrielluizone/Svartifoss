    <string name="community_theme_submit_title">ارسال تم</string>
    <string name="community_theme_submit_preview_description">پیش‌نمایش تمی که در حال ارسال است</string>
    <string name="community_theme_submit_intro">پیش از ظاهر شدن در تم‌های انجمن بررسی می‌شود. هر ۲۴ ساعت می‌توانید تا 10 تم ارسال کنید.</string>
    <string name="community_theme_submit_public_name">نام عمومی تم</string>
    <string name="community_theme_submit_author">نام عمومی سازنده</string>
    <string name="community_theme_submit_author_helper">یک بار انتخاب کنید: A–Z، 0–9، فاصله، نقطه، زیرخط، آپاستروف یا خط تیره. این نام یکتاست و تا وقتی حساب را حذف نکنید ثابت می‌ماند.</string>
    <string name="community_theme_submit_author_first_anonymous_helper">این نام برای همیشه برای حساب شما رزرو می‌شود، اما این تم «ناشناس» را نشان می‌دهد.</string>
    <string name="community_theme_submit_author_fixed_helper">نام عمومی ثابت این حساب. تا وقتی حساب وجود دارد قابل تغییر نیست.</string>
    <string name="community_theme_submit_author_fixed_anonymous_helper">نام ثابت این حساب. این تم آن را پنهان می‌کند و «ناشناس» را نشان می‌دهد.</string>
    <string name="community_theme_submit_publish_anonymously">انتشار به‌صورت ناشناس</string>
    <string name="community_theme_submit_privacy">ورود، ارسال را برای Svartifoss به هویت شما پیوند می‌دهد، اما نام و ایمیل Google شما منتشر نمی‌شوند. نام یکتای سازنده تا زمان حذف حساب به این حساب متصل می‌ماند. انتشار به‌صورت ناشناس فقط آن را در همین تم پنهان می‌کند.</string>
    <string name="community_theme_submit_button">ورود و ارسال</string>
    <string name="community_theme_submit_button_connected">ارسال تم</string>
    <string name="community_theme_submit_progress">در حال ارسال تم شما…</string>
    <string name="community_theme_submit_name_required">یک نام عمومی برای تم وارد کنید.</string>
    <string name="community_theme_submit_author_required">یک نام سازندهٔ معتبر با حروف A–Z، عددها و جداکننده‌های مجاز وارد کنید.</string>
    <string name="community_theme_submit_author_unavailable">این نام سازنده از قبل برای حساب دیگری رزرو شده است. نام دیگری انتخاب کنید.</string>
    <string name="community_theme_submit_author_locked">این حساب از قبل با نام %1$s منتشر می‌کند. نام ثابت بازیابی شد؛ آن را بررسی کنید و دوباره ارسال کنید.</string>
    <string name="community_theme_submit_originality">این تم %1$d تنظیم بصری قابل اعمال را تغییر می‌دهد. پیش از امکان بررسی، دست‌کم %2$d مورد لازم است.</string>
    <string name="community_theme_submit_invalid">این تم ذخیره‌شده قابل ارسال نیست. به «تم‌های من» برگردید و دوباره تلاش کنید.</string>
    <string name="community_theme_submit_unsupported_setting_value">گالری نمی‌تواند «%2$s» را برای %1$s بپذیرد. آن تنظیم را در این تم تغییر دهید و دوباره ارسال کنید.</string>
    <string name="community_theme_submit_unsupported_setting">گالری نمی‌تواند تنظیم %1$s این تم را بپذیرد. آن را تغییر دهید و تم را دوباره ارسال کنید.</string>
    <string name="community_theme_submit_device_local">%1$s از فایلی روی تلفن شما استفاده می‌کند، بنابراین این پوسته فقط همین‌جا قابل استفاده است — گالری تنظیمات را منتقل می‌کند، نه فونت‌ها یا تصاویر شخصی شما را.</string>
    <string name="community_theme_submit_device_local_generic">این پوسته از فونت یا تصویری روی تلفن شما استفاده می‌کند، بنابراین فقط همین‌جا قابل استفاده است — گالری تنظیمات را منتقل می‌کند، نه فایل‌های شخصی شما را.</string>
    <string name="community_theme_submit_duplicate">تمی با دقیقاً همین تنظیمات از قبل روی این چیدمان منتشر شده است. پیش از ارسال، چیزی قابل مشاهده را تغییر دهید.</string>
    <string name="community_theme_submit_sign_in_cancelled">ورود با Google لغو شد. تم شما ارسال نشد.</string>
    <string name="community_theme_submit_limit_reached">در این بازهٔ ۲۴ ساعته از قبل 10 تم ارسال کرده‌اید. پس از پایان آن دوباره تلاش کنید.</string>
    <string name="community_theme_submit_error">این تم ارسال نشد. اتصال خود را بررسی کنید و دوباره تلاش کنید.</string>
    <string name="community_theme_submit_preview_error">آماده‌سازی پیش‌نمایش بررسی ممکن نشد. دوباره تلاش کنید.</string>
    <string name="community_theme_submit_success_title">برای بررسی ارسال شد</string>
    <string name="community_theme_submit_success_message">تم شما منتظر بررسی است. هنوز عمومی نیست.</string>
    <string name="community_theme_submit_picker_action">ارسال تم‌های شما</string>
    <string name="community_theme_submit_picker_title">تا %1$d تم انتخاب کنید</string>
    <string name="community_theme_submit_picker_confirm">ادامه</string>
