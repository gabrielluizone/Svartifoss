    <string name="community_theme_account_title">حساب انجمن</string>
    <string name="community_theme_account_status_google">حساب Google متصل</string>
    <string name="community_theme_account_google_email">به‌عنوان %1$s متصل هستید. نام و ایمیل Google شما عمومی نیستند.</string>
    <string name="community_theme_account_google_detail">هویت Google شما می‌تواند تم ارسال کند. نام نمایهٔ Google شما خصوصی می‌ماند.</string>
    <string name="community_theme_account_public_author_claimed">سازندهٔ عمومی: %1$s\nاین نام یکتاست و تا وقتی این حساب وجود دارد قابل تغییر نیست.</string>
    <string name="community_theme_account_public_author_unclaimed">هنوز سازندهٔ عمومی انتخاب نشده است. نخستین ارسال شما یک نام یکتا برای این حساب رزرو می‌کند.</string>
    <string name="community_theme_account_status_anonymous">حساب ناشناس پسندها</string>
    <string name="community_theme_account_anonymous_detail">این دستگاه یک حساب ناشناس و خصوصی Firebase برای پسندها دارد. برای ارسال تم‌ها، Google را متصل کنید و پسندهای واجد شرایط این دستگاه را نگه دارید.</string>
    <string name="community_theme_account_status_signed_out">هیچ حساب انجمنی متصل نیست</string>
    <string name="community_theme_account_signed_out_detail">مرور بدون حساب هم در دسترس می‌ماند. برای ارسال تم‌ها یک بار Google را متصل کنید؛ اتصال روی همین دستگاه نگه داشته می‌شود.</string>
