    <string name="community_theme_submit_picker_empty_title">هنوز چیزی برای ارسال وجود ندارد</string>
    <string name="community_theme_submit_picker_empty_message">ابتدا در «تم‌های من» یک تم بسازید. تمی که از این گالری دانلود شده باید پیش از ارسال به‌عنوان تم خودتان تکثیر شود.</string>
