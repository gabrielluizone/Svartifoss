<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Lyra Control — Material Design 2, day/night adaptive -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lyra_accent</item>
        <item name="colorPrimaryDark">@color/lyra_sage_dark</item>
        <item name="colorAccent">@color/lyra_accent</item>
        <item name="colorSurface">@color/lyra_surface</item>
        <item name="colorOnSurface">@color/lyra_on_surface</item>
        <item name="android:colorBackground">@color/lyra_background</item>
        <item name="android:textColorPrimary">@color/lyra_text_primary_selector</item>
        <item name="android:textColorSecondary">@color/lyra_text_secondary</item>
        <!-- Ripple e controles: Sage em vez de roxo -->
        <item name="colorControlNormal">@color/lyra_on_surface</item>
        <item name="colorControlActivated">@color/lyra_accent</item>
        <item name="colorControlHighlight">@color/lyra_ripple</item>
        <item name="colorSwitchThumbNormal">@color/lyra_stone</item>
        <item name="buttonBarButtonStyle">@style/LyraDialogButton</item>
        <item name="alertDialogTheme">@style/LyraAlertDialogTheme</item>
        <!-- Status bar adaptável ao modo -->
        <item name="android:statusBarColor">@color/lyra_background</item>
        <item name="android:windowLightStatusBar">@bool/is_light_mode</item>
        <!-- Typography -->
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="preferenceTheme">@style/LyraPreferenceTheme</item>
    </style>

    <style name="LyraPreferenceTheme" parent="@style/PreferenceThemeOverlay.v14.Material">
        <item name="preferenceCategoryStyle">@style/LyraPreferenceCategory</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/LyraPrefCategoryText</item>
    </style>

    <style name="LyraPreferenceCategory" parent="@style/Preference.Category">
        <item name="android:layout">@layout/pref_category_header</item>
    </style>

    <style name="LyraPrefCategoryText" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/lyra_accent</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="LyraToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="android:statusBarColor">@color/lyra_background</item>
        <item name="android:windowLightStatusBar">@bool/is_light_mode</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <style name="LyraDialogBase" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/lyra_accent</item>
        <item name="colorPrimaryDark">@color/lyra_sage_dark</item>
        <item name="colorAccent">@color/lyra_accent</item>
        <item name="colorSurface">@color/lyra_surface</item>
        <item name="colorOnSurface">@color/lyra_on_surface</item>
        <item name="android:colorBackground">@color/lyra_surface</item>
        <item name="android:windowBackground">@drawable/dialog_bg_lyra</item>
        <item name="android:textColorPrimary">@color/lyra_text_primary_selector</item>
        <item name="android:textColorSecondary">@color/lyra_text_secondary</item>
        <item name="colorControlNormal">@color/lyra_on_surface</item>
        <item name="colorControlActivated">@color/lyra_accent</item>
        <item name="colorControlHighlight">@color/lyra_ripple</item>
        <item name="buttonBarButtonStyle">@style/LyraDialogButton</item>
        <item name="alertDialogTheme">@style/LyraAlertDialogTheme</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>

    <!-- AlertDialog.Builder dialogs (playlist add, permission prompts, ...) don't inflate our
         popup layouts, so the Lyra look has to come from the dialog theme itself: 12dp window
         corners and the metric-fixed bar buttons. Colors that must follow the runtime accent
         are still applied per-dialog after show(). -->
    <style name="LyraAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_lyra</item>
        <item name="buttonBarPositiveButtonStyle">@style/LyraDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/LyraDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/LyraDialogButton</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <!-- A ListPreference's radio-choice dialog (e.g. "Track time display") renders the
             platform's CheckedTextView row, whose vertical centering assumes Roboto's font
             metrics. Google Sans's extra font padding pushed the label out of line with its
             radio dot; disabling it here (same fix already applied by hand to the app's own
             OutlineTextViews) puts every such dialog's text back on the dot's centerline. -->
        <item name="android:checkedTextViewStyle">@style/LyraCheckedTextView</item>
    </style>

    <style name="LyraCheckedTextView" parent="@android:style/Widget.Material.CheckedTextView">
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="AppTheme.Dialog" parent="LyraDialogBase">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="AppTheme.Dialog.Short" parent="LyraDialogBase">
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

    <!-- Bottom nav label: 13sp (um pouquinho maior que o padrão 12sp) -->
    <style name="LyraBottomNavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>

    <!-- Selected and unselected tabs deliberately share every font metric. Material 1.13 can
         apply a second TextAppearance during selection; if its line box differs even slightly,
         the label visibly jumps before settling in the center. Only the ColorStateList changes. -->
    <style name="LyraTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">true</item>
        <item name="textAllCaps">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="lineHeight">18sp</item>
    </style>

    <!-- Gesture-picker action button: neutral text, subtle outline. Icon+text anchor to the
         start edge (list-row style) instead of centering: MaterialButton's centered-icon math
         (iconGravity=textStart + gravity=center) re-derives the icon offset from the text
         width, so rows with different-length titles started at ragged x positions and the
         icon could keep a stale offset after a text-only rebind. With start-aligned text the
         icon is simply pinned at paddingStart, so every row lines up identically.
         iconTint=@null is load-bearing: the OutlinedButton default is colorPrimary (sage) and
         would override the manual PorterDuff tints the fragments apply to action icons. -->
    <style name="LyraGestureButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="strokeColor">@color/lyra_divider</item>
        <item name="rippleColor">@color/lyra_ripple</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">@dimen/action_icon_size</item>
        <item name="iconTint">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- Same google_sans metric fix as LyraDialogButton: keeps the label vertically
             centered in the 52dp row instead of riding ~3dp high. -->
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Dialog bar buttons (OK/Cancel/...): the stock TextButton.Dialog ripple derives from
         colorPrimary (sage) at inflation time, so it could never follow a runtime accent change -
         press feedback is theme-neutral instead, like every other pressed surface.
         includeFontPadding=false: google_sans has wildly asymmetric extreme metrics
         (winDescent ~1.08em vs winAscent ~1.32em on caps reaching only 0.72em), so the default
         font-padding line box floats the visible text ~0.2em above the button's center; without
         it the box is built from real ascent/descent and the text sits centered like the system
         dialogs'. -->
    <!-- Filled counterpart to LyraGestureButton for a screen's single primary action (e.g. the
         Updates page's "Update watch"). backgroundTint is set at runtime to the live Lyra accent
         so it follows a user-picked accent; the label/icon are white. Same google_sans metric fix
         (includeFontPadding=false) as the other Lyra buttons so the label sits centered. -->
    <style name="LyraFilledButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">@dimen/action_icon_size</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/lyra_ripple</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- A reaction is deliberately rendered as a borderless icon/count action. Its transparent
         48dp target keeps the row quiet without sacrificing touch accessibility. -->
    <style name="LyraCommunityLikeButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">5dp</item>
        <item name="iconSize">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/lyra_ripple</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Every preview-surface choice uses identical metrics so short and long labels remain
         optically centred inside the joined toggle group. -->
    <style name="LyraCommunityDetailSurfaceButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/lyra_ripple</item>
    </style>

    <!-- Compact, intrinsic-width filters for the rebuilt Community gallery. Runtime styling
         supplies the live accent only for active choices and leaves the other chips neutral. -->
    <style name="LyraCommunityGalleryChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:minHeight">40dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="iconStartPadding">0dp</item>
        <item name="iconEndPadding">6dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="rippleColor">@color/lyra_ripple</item>
    </style>

    <style name="LyraDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="rippleColor">@color/lyra_ripple</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
