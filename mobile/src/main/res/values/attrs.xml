<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A single-choice ListPreference whose modal dialog shows a per-option description under
         each name, instead of hiding the descriptions the way a stock ListPreference does. -->
    <declare-styleable name="DescribedListPreference">
        <!-- String-array of per-entry descriptions, parallel to android:entries/entryValues. -->
        <attr name="descriptions" format="reference" />
        <!-- Renders each dialog row's label in the typeface its entryValue names. Font picker only. -->
        <attr name="previewTypeface" format="boolean" />
    </declare-styleable>

    <declare-styleable name="ColorTreatmentPreference">
        <!-- The preference key holding this target's own custom color (e.g.
             wear_artist_custom_color), consulted for the "Normal" row's swatch preview before
             falling back to the global wear_normal_color. Omit for the global watch-wide picker,
             which has no per-target override to consult. -->
        <attr name="customColorKey" format="string" />
    </declare-styleable>
</resources>
