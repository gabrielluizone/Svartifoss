    <string name="no_watch_app_title">Install Svartifoss on your watch</string>
    <string name="no_watch_app_description">Svartifoss couldn\'t find its watch app on your paired Wear OS watch. The phone and watch apps work together — without the watch app, controlling playback from your wrist won\'t work.\n\nTap \"Open Play Store\" to open the Play Store on your watch and install Svartifoss there. If you just installed it, give it a minute to finish syncing.</string>
    <string name="no_watch_app_button">Open Play Store</string>
    <string name="required_permission">Required permission</string>
    <string name="setting_pause_on_swipe_exit">Pause playback on swipe exit</string>
    <string name="setting_pause_on_swipe_exit_description">Automatically pause any playback when exiting Svartifoss on the watch via swipe-left gesture.\n\nExiting via power button is not affected and it will never auto-pause.</string>
    <string name="setting_rotating_crown_off_period">Rotary input screen on delay</string>
    <string name="setting_rotating_crown_off_period_description">Rotating inputs (for example rotating crowns) can be oversensitive on some devices. To prevent accidental volume changes, rotary input will be disabled for <![CDATA[<b>%1$s milliseconds</b>]]> after you turn the screen on.</string>
    <string name="setting_rotary_seek">Seek with rotary crown</string>
    <string name="setting_rotary_seek_description">When enabled, rotating the crown scrubs through the current track instead of changing volume. Volume can still be changed with on-screen or physical buttons.</string>
    <string name="setting_rotating_sensitivity">Rotary input sensitivity</string>
    <string name="setting_rotating_sensitivity_description">Sensitivity for rotary input. Higher number means moving the rotary crown the same way will increase volume for more. Currently set to <![CDATA[<b>%1$s%%</b>]]>.</string>
    <string name="setting_disable_ambient_physical_double_click">Disable physical button double click in ambient</string>
    <string name="setting_disable_ambient_physical_double_click_description">Some watches have buggy buttons where single click of the physical button in ambient mode sometimes gets registered as double click.\n\nIf you experience this, you can enable this option to completely disable double clicks in ambient mode (e.g. clicking twice will just activate single click action). Clicking button twice when watch is active is not affected.</string>
    <string name="setting_haptic_feedback">Haptic feedback</string>
    <string name="setting_haptic_feedback_description">Vibrate the watch when pressing buttons.</string>
    <string name="setting_auto_start">Open Svartifoss automatically</string>
    <string name="setting_auto_start_description">Automatically open Svartifoss on the watch when music playback is started on the phone.</string>
    <string name="setting_auto_start_apps_blacklist">Auto-start apps</string>
    <string name="setting_auto_start_apps_blacklist_description">List of media apps that can auto-start Svartifoss</string>
    <string name="setting_dim_album_art">Dim the album art</string>
    <string name="setting_dim_album_art_description">When enabled, displayed album art will be dimmed, allowing for better text visibility.</string>
    <string name="setting_album_art_style">Album art style</string>
    <string name="setting_album_art_style_description">Choose how the now-playing background looks on the watch.</string>
    <string name="setting_album_art_blur_radius">Blur intensity</string>
    <string name="setting_album_art_blur_radius_description">Strength of the full-screen blur when album art style is set to Blur. Currently <![CDATA[<b>%1$s px</b>]]>.</string>
    <string name="setting_album_art_dim_strength">Dim strength</string>
    <string name="setting_album_art_dim_strength_description">How strongly the album art is darkened for text readability. Currently <![CDATA[<b>%1$s%%</b>]]>.</string>
    <string name="setting_ambient_album_art_opacity">Ambient album art opacity</string>
    <string name="setting_ambient_album_art_opacity_description">How visible the album art remains in ambient mode. Currently <![CDATA[<b>%1$s%%</b>]]>.</string>
