<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lyra design system — paleta base (luz e sombra compartilhadas) -->
    <color name="lyra_sage">#87A89F</color>
    <color name="lyra_sage_dark">#6B9088</color>
    <!-- Accent adaptável: mais suave no modo claro, sage no modo escuro (sobrescrito em values-night) -->
    <color name="lyra_accent">#86a69d</color>
    <color name="lyra_accent_highlight">#204A9488</color>
    <!-- Press/ripple highlight: deliberately NEUTRAL (not accent-derived). The accent is user
         customizable at runtime, but theme attributes like colorControlHighlight resolve once at
         inflation - an accent-tinted ripple here permanently kept the DEFAULT sage green on
         every pressed row/button no matter what accent the user later picked. Gray never
         clashes. Overridden for dark mode in values-night. -->
    <color name="lyra_ripple">#1F000000</color>

    <!-- Modo claro -->
    <color name="lyra_white">#FFFFFF</color>
    <color name="lyra_mist">#F2F2F2</color>
    <color name="lyra_stone">#E2E2E2</color>
    <color name="lyra_pewter">#888888</color>
    <color name="lyra_ink">#1A1A1A</color>

    <!-- Modo escuro (OLED) -->
    <color name="lyra_void">#0A0A0A</color>
    <color name="lyra_shadow">#141414</color>
    <color name="lyra_carbon">#1E1E1E</color>
    <color name="lyra_ash">#606060</color>
    <color name="lyra_snow">#F0F0F0</color>

    <!-- Cores adaptáveis — sobrescritas em values-night -->
    <color name="lyra_background">@color/lyra_white</color>
    <color name="lyra_surface">@color/lyra_mist</color>
    <color name="lyra_on_surface">@color/lyra_ink</color>
    <color name="lyra_text_secondary">@color/lyra_pewter</color>
    <color name="lyra_divider">@color/lyra_stone</color>
    <color name="lyra_nav_inactive">@color/lyra_pewter</color>
    <color name="lyra_pref_summary">#767676</color>

    <!-- Pending-update badge (toolbar help icon, see MainActivity.refreshHelpIcon). Kept fixed
         (not accent-derived) so it always reads as a status color regardless of the user's
         chosen accent - same reasoning as lyra_ripple. -->
    <color name="lyra_update_badge">#4CAF6B</color>

    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="watch_background">#DEDEDE</color>
</resources>
