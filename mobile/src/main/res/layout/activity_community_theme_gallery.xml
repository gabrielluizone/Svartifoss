<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/community_gallery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">

        <ImageButton
            android:id="@+id/community_gallery_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/lyra_on_surface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/community_gallery_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/online_themes_title"
            android:textColor="@color/lyra_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/community_gallery_submissions"
            app:layout_constraintStart_toEndOf="@id/community_gallery_back"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/community_gallery_submissions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/community_theme_submissions_action"
            android:padding="12dp"
            android:src="@drawable/ic_history"
            android:tint="@color/lyra_on_surface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/community_gallery_refresh"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseAppTint" />

        <ImageButton
            android:id="@+id/community_gallery_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/online_theme_refresh"
            android:padding="12dp"
            android:src="@drawable/ic_autorenew"
            android:tint="@color/lyra_on_surface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/community_gallery_discovery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/community_gallery_search_box"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:boxBackgroundColor="@color/lyra_surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/lyra_text_secondary"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/lyra_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/community_gallery_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:background="@null"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:hint="@string/online_theme_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/lyra_on_surface"
                android:textColorHint="@color/lyra_text_secondary"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:id="@+id/community_gallery_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/community_gallery_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/community_gallery_layout_filter"
                    style="@style/LyraCommunityGalleryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/online_theme_filter_layout"
                    app:chipIcon="@drawable/ic_tune"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/community_gallery_sort"
                    style="@style/LyraCommunityGalleryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/online_theme_sort_newest_short" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/community_gallery_installed_filter"
                    style="@style/LyraCommunityGalleryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/online_theme_filter_not_installed"
                    app:chipIcon="@drawable/ic_download_for_offline"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/community_gallery_liked_filter"
                    style="@style/LyraCommunityGalleryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/online_theme_filter_liked"
                    app:chipIcon="@drawable/ic_favorite_border"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/community_gallery_clear_filters"
                    style="@style/LyraCommunityGalleryChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:gravity="center"
                    android:text="@string/online_theme_clear_filters"
                    android:textAlignment="center"
                    android:visibility="gone"
                    app:chipIconVisible="false" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/community_gallery_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:contentDescription="@string/online_theme_list_description"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="20dp"
            tools:listitem="@layout/item_community_theme_card" />

        <LinearLayout
            android:id="@+id/community_gallery_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lyra_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/community_gallery_state_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_palette"
                android:tint="@color/lyra_accent"
                android:visibility="gone"
                tools:ignore="UseAppTint" />

            <com.svartifoss.snfell.view.MusicLoadingBarsView
                android:id="@+id/community_gallery_progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/online_theme_loading"
                app:tint="@color/lyra_accent" />

            <TextView
                android:id="@+id/community_gallery_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/google_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/online_theme_loading"
                android:textColor="@color/lyra_on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/community_gallery_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/community_gallery_retry"
                style="@style/LyraFilledButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:minWidth="0dp"
                android:text="@string/online_theme_retry"
                android:visibility="gone"
                app:icon="@drawable/ic_autorenew" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/community_gallery_state_clear"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/google_sans"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:text="@string/online_theme_clear_filters"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Declared after the state overlay so it stays reachable while the list is empty,
             loading or offline: submitting reads the local library and needs no catalogue. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/community_gallery_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/community_theme_submit_picker_action"
            android:src="@drawable/ic_upload_file"
            android:visibility="gone"
            app:backgroundTint="@color/lyra_accent"
            app:elevation="6dp"
            app:fabSize="normal"
            app:tint="@color/lyra_white" />

    </FrameLayout>

</LinearLayout>
