<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lyra_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left"
            android:tint="@color/lyra_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:text="@string/online_themes_title"
            android:textColor="@color/lyra_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/online_theme_refresh"
            android:padding="12dp"
            android:src="@drawable/ic_autorenew"
            android:tint="@color/lyra_on_surface" />

    </LinearLayout>

    <TextView
        android:id="@+id/community_theme_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/google_sans"
        android:includeFontPadding="false"
        android:text="@string/online_theme_intro"
        android:textColor="@color/lyra_text_secondary"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/community_theme_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:contentDescription="@string/online_theme_list_description"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/community_theme_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <ProgressBar
                android:id="@+id/community_theme_progress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/lyra_accent" />

            <TextView
                android:id="@+id/community_theme_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_retry_community_themes"
                style="@style/LyraGestureButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/online_theme_retry"
                android:visibility="gone"
                app:icon="@drawable/ic_autorenew" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
