<?xml version="1.0" encoding="utf-8"?>
<!-- One slot row in the quick-actions-panel config dialog: current icon + slot name +
     assigned action. Tap picks a new action, long-press restores the slot's default. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/slot_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription"
        tools:src="@drawable/action_like" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/slot_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-3dp"
            android:fontFamily="@font/google_sans"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            tools:text="Button 1" />

        <TextView
            android:id="@+id/slot_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-5dp"
            android:fontFamily="@font/google_sans"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="13sp"
            tools:text="Like (default)" />

    </LinearLayout>

</LinearLayout>
