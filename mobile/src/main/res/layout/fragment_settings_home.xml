<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/settings_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/lyra_background"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/lyra_accent"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/lyra_ripple"
        app:tabSelectedTextColor="@color/lyra_accent"
        app:tabSelectedTextAppearance="@style/LyraTabText"
        app:tabTextAppearance="@style/LyraTabText"
        app:tabTextColor="@color/lyra_text_secondary" />

    <TextView
        android:id="@+id/settings_section_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:textColor="@color/lyra_pref_summary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lyra_divider" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/settings_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
