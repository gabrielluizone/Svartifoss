<?xml version="1.0" encoding="utf-8"?>
<!--
    The reasons are a closed vocabulary, mirrored literally in firestore.rules. Radio buttons
    rather than a spinner because the point of the list is to be read: somebody opening this has
    already decided something is wrong and is looking for the words for it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/community_theme_report_intro"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/community_theme_report_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/community_theme_report_inappropriate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_inappropriate"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/community_theme_report_impersonation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_impersonation"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/community_theme_report_misleading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_misleading"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/community_theme_report_illegible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_illegible"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/community_theme_report_spam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_spam"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/community_theme_report_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:minHeight="44dp"
                android:text="@string/community_theme_report_reason_other"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

        </RadioGroup>

        <EditText
            android:id="@+id/community_theme_report_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints=""
            android:fontFamily="@font/google_sans"
            android:gravity="top|start"
            android:hint="@string/community_theme_report_details_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="2"
            android:textColor="@color/lyra_on_surface"
            android:textColorHint="@color/lyra_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/community_theme_report_privacy"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
