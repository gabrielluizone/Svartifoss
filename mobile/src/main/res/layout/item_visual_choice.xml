<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of a style picker's grid: the user's own watch with this one value, drawn by the real
     preview, and the value's name underneath. The chosen value is ringed. The whole cell is the
     touch target and the accessibility node, read as a radio button with its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingTop="8dp"
    android:paddingEnd="2dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/visual_choice_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <View
            android:id="@+id/visual_choice_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/visual_choice_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/google_sans"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/lyra_on_surface"
        android:textSize="12sp"
        tools:text="Blurred art" />

</LinearLayout>
