<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/community_theme_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/lyra_on_surface" />

        <TextView
            android:id="@+id/community_theme_detail_toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/community_theme_detail_title"
            android:textColor="@color/lyra_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/community_theme_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/community_theme_detail_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/lyra_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <com.svartifoss.snfell.view.watchface.WatchPreviewView
                        android:id="@+id/community_theme_detail_preview"
                        android:layout_width="232dp"
                        android:layout_height="232dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@string/community_theme_detail_title" />

                    <TextView
                        android:id="@+id/community_theme_detail_preview_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="18dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:textColor="@color/lyra_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/community_theme_detail_surface_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:scrollbars="none">

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/community_theme_detail_surfaces"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_player"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_player" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_aod"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_aod" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_volume"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_volume" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_progress"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_progress" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_quick_panel"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_quick_panel" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/community_theme_detail_surface_queue"
                                style="@style/LyraCommunityDetailSurfaceButton"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/community_theme_detail_surface_queue" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </HorizontalScrollView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="18dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/community_theme_detail_preview_privacy"
                        android:textColor="@color/lyra_text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/lyra_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lyra_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/community_theme_detail_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:textColor="@color/lyra_on_surface"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/community_theme_detail_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/lyra_text_secondary"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_like_community_theme"
                            style="@style/LyraCommunityLikeButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:minWidth="0dp"
                            app:icon="@drawable/ic_favorite_border" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/lyra_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:text="@string/community_theme_detail_information"
                        android:textColor="@color/lyra_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:text="@string/community_theme_detail_layout"
                                android:textColor="@color/lyra_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/community_theme_detail_layout_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/lyra_on_surface"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <Space
                            android:layout_width="24dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:text="@string/community_theme_detail_published"
                                android:textColor="@color/lyra_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/community_theme_detail_published_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/lyra_on_surface"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:minHeight="32dp"
                                android:text="@string/community_theme_detail_minimum_version"
                                android:textColor="@color/lyra_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/community_theme_detail_minimum_version_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/lyra_on_surface"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <Space
                            android:layout_width="24dp"
                            android:layout_height="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:minHeight="32dp"
                                android:text="@string/community_theme_detail_visual_settings"
                                android:textColor="@color/lyra_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/community_theme_detail_settings_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/google_sans"
                                android:includeFontPadding="false"
                                android:textColor="@color/lyra_on_surface"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/community_theme_detail_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add_apply_community_theme"
        style="@style/LyraFilledButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/community_theme_detail_add_apply"
        app:icon="@drawable/ic_download" />

</LinearLayout>
