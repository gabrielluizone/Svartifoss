<?xml version="1.0" encoding="utf-8"?>
<!-- The "Add to watch menu" sheet: the whole of adding to the menu in one place. The first row
     is the way into the full action picker - kept at the top, where it cannot be missed, because
     everything that is not a streaming link lives there. Below it, paste a link (its name is
     looked up) or tick things already saved. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lyra_background"
    android:fillViewport="true">

    <!-- focusableInTouchMode + beforeDescendants: the container takes the initial focus, so the
         link field does not and the keyboard stays down until the field is actually tapped. -->
    <LinearLayout
        android:id="@+id/sheet_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/lyra_divider" />

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineHeight="25sp"
            android:text="@string/add_menu_title"
            android:textColor="@color/lyra_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineHeight="18sp"
            android:text="@string/add_menu_subtitle"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp" />

        <!-- The way into the full action picker. Kept up here, not at the foot of the sheet where
             a person adding a link would never scroll to it. -->
        <LinearLayout
            android:id="@+id/sheet_other_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/sheet_choice_row_bg"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_icon_bg"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_gamepad"
                android:tint="@color/lyra_on_surface"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:lineHeight="21sp"
                    android:text="@string/add_menu_actions_title"
                    android:textColor="@color/lyra_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:lineHeight="18sp"
                    android:text="@string/add_menu_actions_desc"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/lyra_text_secondary"
                tools:ignore="UseAppTint" />

        </LinearLayout>

        <TextView
            android:id="@+id/sheet_or_link_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:letterSpacing="0.1"
            android:text="@string/add_menu_or_link"
            android:textAllCaps="true"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_link_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/add_menu_link_hint"
                app:boxStrokeColor="@color/lyra_accent"
                app:hintTextColor="@color/lyra_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_link_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:imeOptions="actionNext"
                    android:includeFontPadding="false"
                    android:inputType="textUri"
                    android:lineHeight="20sp"
                    android:maxLines="1"
                    android:textSize="14sp"
                    tools:text="https://music.youtube.com/playlist?list=PL123" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_paste"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:letterSpacing="0"
                android:text="@string/add_menu_paste"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Service and kind, read off the link as it is typed: the reassurance that the link was
             understood, before anything is saved. -->
        <TextView
            android:id="@+id/sheet_detected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineHeight="18sp"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="YouTube Music • Playlist"
            tools:visibility="visible" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sheet_name_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/playlist_shortcut_name_hint"
            app:boxStrokeColor="@color/lyra_accent"
            app:hintTextColor="@color/lyra_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sheet_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="textCapSentences"
                android:lineHeight="21sp"
                android:maxLines="1"
                android:textSize="15sp"
                tools:text="Discover Weekly" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Where the name comes from: a button when the lookup is the user's to ask for, the
             house loading bars while it runs, and one line saying so when it found nothing. -->
        <LinearLayout
            android:id="@+id/sheet_lookup_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <com.svartifoss.snfell.view.MusicLoadingBarsView
                android:id="@+id/sheet_lookup_bars"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_lookup_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="@string/add_menu_get_name"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sheet_lookup_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:lineHeight="18sp"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="12sp"
                tools:text="Looking up the name…" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/sheet_shuffle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:text="@string/playlist_shortcut_shuffle"
            android:textColor="@color/lyra_on_surface"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_add"
            style="@style/LyraFilledButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/add_menu_add" />

        <!-- Confirmation of the last addition. The sheet stays open after one so the next link can
             be pasted straight away; this is what says the previous one landed. -->
        <TextView
            android:id="@+id/sheet_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineHeight="18sp"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Added “Happy Hits” to the menu"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/sheet_saved_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/lyra_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/add_menu_saved_title"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/sheet_saved_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_add_selected"
                style="@style/LyraFilledButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="Add 2 to menu"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
