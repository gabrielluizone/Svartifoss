<?xml version="1.0" encoding="utf-8"?>
<!-- The Always-on page, built around the one thing it is about: the ambient style, and what that
     screen shows while the watch sleeps.

     Deliberately *not* the target rail the Text, Color and Panel editors use - the same reasoning
     as the Player page. Those three apply a repeated set of controls to parallel subjects, so
     swapping the subject is the natural gesture; ambient describes a single screen, and a rail
     here would be tabs holding unrelated lists.

     So the six existence toggles become a field of chips: they are the same question asked six
     times ("is this on the ambient screen?"), a chip answers it in a quarter of the height, and
     the set reads at a glance rather than as six sentences each ending in "on always-on display".
     Only genuine choices stay as rows, because a chip cannot express one.

     Which controls appear is decided at bind time from AodEditorModel, so an ambient style only
     ever shows what it can actually draw. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/aod_editor_style_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/category_wear_aod"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- The style names itself, so this row carries the value alone: the heading above
                 already says which screen is being chosen for. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_style_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_always_on"
                tools:text="Follow the player face" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_colors"
                tools:text="Tint · White" />

            <!-- Revealed only by the Custom tint, the pairing the Colors page always had: the mode
                 dialog reports an actual change only, so re-picking Custom could never reach a
                 swatch and the hex row is hidden on this page like every other legacy row. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_custom_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_palette"
                tools:text="Always-on custom color"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_intensity_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_brightness_medium"
                tools:text="Brightness · 100%" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/aod_editor_elements_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/player_section_on_screen"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- One chip per element this ambient style can draw, built from AodEditorModel. -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/aod_editor_element_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="2dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- The artwork's own treatment. Gone entirely when the style draws no artwork, or when the
         chip above has turned it off - the two rows would then describe a picture nobody sees. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/aod_editor_artwork_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/aod_editor_artwork_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/aod_section_artwork"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_art_treatment_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_album"
                tools:text="Treatment · Blurred" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/aod_editor_art_opacity_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_opacity"
                tools:text="Opacity · 55%" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
