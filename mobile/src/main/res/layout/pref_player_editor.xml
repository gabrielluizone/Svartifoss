<?xml version="1.0" encoding="utf-8"?>
<!-- The Player page, built around the one thing it is about: the face, and what appears on it.

     Deliberately *not* the target rail the Text, Color and Panel editors use. Those three apply a
     repeated set of controls to parallel subjects, so swapping the subject is the natural gesture.
     Player describes a single screen, so its controls are grouped by what they are about instead:
     one card per subject - Layout, Track info, Progress, Controls, Clock - each holding every
     setting for it, the ring's switches directly above the ring's own style and layout.

     Those cards used to be one "On screen" card of existence chips with every picker listed under
     them, which separated the ring's switches from the ring's pickers and left no room for the
     sentence each setting carries to say what it does.

     Almost nothing here is declared. The cards and rows are built from PlayerEditorModel at bind
     time, so a face only ever shows the groups - and the rows inside them - it can consume. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/player_editor_face_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/category_screen_face"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_editor_face_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_player_theme"
                tools:text="Classic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_editor_screen_theme_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_palette"
                tools:text="Default" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- One card per subject the current face has rows for, built from PlayerEditorModel. Each
         card is inflated from editor_group_card and carries its own top margin. -->
    <LinearLayout
        android:id="@+id/player_editor_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Only the Metadata face draws these, so the whole card goes when it is not selected. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_editor_details_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/player_editor_details_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/category_wf_metadata"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/player_editor_detail_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="2dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="8dp">

            <!-- Not part of the composition: how the screen behaves while it is up. Rendered with
                 the same row as the subject cards, so its description is not lost. -->
            <LinearLayout
                android:id="@+id/player_editor_behaviour_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player_editor_reset_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_autorenew"
                tools:text="Reset this layout" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
