<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/editor_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_icon_bg"
                android:contentDescription="@null"
                android:padding="13dp"
                android:src="@drawable/ic_playlist_add"
                android:tint="@color/lyra_accent"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/editor_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:lineHeight="25sp"
                    android:text="@string/playlist_shortcuts_add"
                    android:textColor="@color/lyra_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:lineHeight="18sp"
                    android:text="@string/playlist_shortcut_editor_hint"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/playlist_shortcut_name_hint"
            app:boxStrokeColor="@color/lyra_accent"
            app:hintTextColor="@color/lyra_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:lineHeight="21sp"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textSize="15sp"
                tools:text="Discover Weekly" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/link_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/playlist_shortcut_link_hint"
            app:boxStrokeColor="@color/lyra_accent"
            app:endIconDrawable="@drawable/ic_playlist_add"
            app:endIconMode="custom"
            app:endIconTint="@color/lyra_accent"
            app:hintTextColor="@color/lyra_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/link_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:lineHeight="20sp"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="2"
                android:textSize="14sp"
                tools:text="https://open.spotify.com/playlist/abc" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/detected_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/lyra_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/lyra_divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/detected_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_icon_bg"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="@color/lyra_text_secondary"
                    tools:ignore="UseAppTint" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detected_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:lineHeight="20sp"
                        android:text="@string/playlist_shortcut_detection_waiting"
                        android:textColor="@color/lyra_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detected_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:lineHeight="18sp"
                        android:textColor="@color/lyra_text_secondary"
                        android:textSize="12sp"
                        tools:text="YouTube Music • Spotify • Deezer • TIDAL • Apple Music • Amazon Music • SoundCloud • Qobuz • Bandcamp • Audiomack • Mixcloud • Pandora" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <CheckBox
            android:id="@+id/shuffle_checkbox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:text="@string/playlist_shortcut_shuffle"
            android:textColor="@color/lyra_on_surface"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@android:string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/lyra_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save"
                style="@style/LyraFilledButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/playlist_shortcut_save"
                app:icon="@drawable/ic_playlist_add" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
