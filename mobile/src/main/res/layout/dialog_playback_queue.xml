<?xml version="1.0" encoding="utf-8"?>
<!-- The queue window the persistent notification opens (PlaybackQueueActivity): the track playing,
     with its controls, above the queue. The rows are the mini player's queue sheet's own
     (item_queue_song through QueueAdapter), so the two lists look and behave the same.

     The list's height is set in code, as tall as its rows up to what the screen leaves after the
     player, and the whole window scrolls when even that does not fit (a phone held sideways). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="14dp">

        <!-- The track playing now. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <ImageView
                android:id="@+id/queue_window_cover"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_queue_window_cover"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/queue_window_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="@color/lyra_on_surface"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="MURI MURI EVOLUTION" />

                <TextView
                    android:id="@+id/queue_window_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="14sp"
                    tools:text="NANAOAKARI" />

                <!-- The app the music comes from. -->
                <LinearLayout
                    android:id="@+id/queue_window_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/queue_window_source_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/queue_window_source_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/lyra_text_secondary"
                        android:textSize="12sp"
                        tools:text="YouTube Music" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <SeekBar
            android:id="@+id/queue_window_seek"
            style="@style/Widget.AppCompat.SeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="10000"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:progressBackgroundTint="@color/lyra_divider" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/queue_window_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="11sp"
                tools:text="1:12" />

            <TextView
                android:id="@+id/queue_window_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/google_sans"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="11sp"
                tools:text="3:14" />

        </RelativeLayout>

        <!-- The player's own buttons, in its own order and with its own icons: the row its media
             notification shows (PlaybackQueueActivity.refreshControls builds it). -->
        <LinearLayout
            android:id="@+id/queue_window_controls"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <!-- The glyph and the field share one centred line inside the pill. The field has no
             background and no font padding, so its text sits on the glyph's centre rather than on
             an underline's. -->
        <LinearLayout
            android:id="@+id/queue_window_search_box"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_queue_window_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/lyra_text_secondary" />

            <EditText
                android:id="@+id/queue_window_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical|start"
                android:hint="@string/queue_window_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/lyra_on_surface"
                android:textColorHint="@color/lyra_pref_summary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- "Up next · 10" and the switch that brings the played tracks back above it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/queue_window_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Up next · 10" />

            <TextView
                android:id="@+id/queue_window_played_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="2dp"
                android:drawableTint="@color/lyra_text_secondary"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:minHeight="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="12sp"
                tools:ignore="UseAppTint"
                tools:text="Played · 14" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playback_queue_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="12dp"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none" />

        <!-- Shown in place of the list when there is no queue, or nothing matches the search. -->
        <TextView
            android:id="@+id/playback_queue_empty"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:fontFamily="@font/google_sans"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/queue_unavailable"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
