<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lyra_background"
    android:orientation="vertical">

    <!-- Live miniature of the watch's now-playing screen; the preference list below scrolls
         under it, so the preview stays visible while adjusting anything. -->
    <com.svartifoss.snfell.view.watchface.WatchPreviewView
        android:id="@+id/watch_preview"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/watch_face_prefs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
