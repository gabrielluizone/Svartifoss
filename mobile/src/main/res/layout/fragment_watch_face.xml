<?xml version="1.0" encoding="utf-8"?>
<!-- The Watch tab: the preview pinned on top with a caption naming what it shows, and below it
     either Home (the themes and the list of areas) or one area's editor with the rail of the seven
     areas. WatchFaceFragment switches between the two containers; the land layout carries the same
     ids, which WatchTabStructureTest pins. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The preview owns this area: its size is calculated from the actual space left after the
         toolbar, mini player and bottom navigation are laid out. The 140dp seed prevents a zero-
         size first frame; WatchFaceFragment replaces it with the responsive value immediately. -->
    <LinearLayout
        android:id="@+id/watch_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.svartifoss.snfell.view.watchface.WatchPreviewView
            android:id="@+id/watch_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/watch_preview_description"
            android:importantForAccessibility="yes" />

        <!-- The theme being edited, and the screen the preview shows when it is not the player. -->
        <TextView
            android:id="@+id/watch_preview_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/lyra_on_surface"
            android:textSize="14sp"
            tools:text="Studio · Volume" />

        <!-- Shown while no watch has reported in, so changes that never reach a wrist are
             explained; the Settings tab's banner says the same with the same strings. -->
        <TextView
            android:id="@+id/watch_no_watch_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="No watch connected" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/watch_home_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/watch_editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/lyra_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back to Home. ic_arrow_back is auto-mirrored, so it points the right way in the
                 four right-to-left locales. -->
            <ImageButton
                android:id="@+id/watch_editor_home"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/lyra_on_surface"
                tools:ignore="UseAppTint" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/watch_tabs"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/lyra_background"
                app:tabGravity="start"
                app:tabIndicatorColor="@color/lyra_accent"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabRippleColor="@color/lyra_ripple"
                app:tabSelectedTextColor="@color/lyra_accent"
                app:tabSelectedTextAppearance="@style/LyraTabText"
                app:tabTextAppearance="@style/LyraTabText"
                app:tabTextColor="@color/lyra_text_secondary" />

        </LinearLayout>

        <!-- What the selected area holds, the sentence Home's list already shows beside it; the
             Settings tab says the same under its own rail. -->
        <TextView
            android:id="@+id/watch_section_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/lyra_background"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:maxLines="2"
            android:paddingStart="20dp"
            android:paddingTop="2dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="13sp"
            tools:text="Control album art, blur, fading and readability behind the player." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lyra_divider" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/watch_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
