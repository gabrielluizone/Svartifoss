<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The preview owns this area: its size is calculated from the actual space left after the
         toolbar, mini player and bottom navigation are laid out. The 140dp seed prevents a zero-
         size first frame; WatchFaceFragment replaces it with the responsive value immediately. -->
    <FrameLayout
        android:id="@+id/watch_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <com.svartifoss.snfell.view.watchface.WatchPreviewView
            android:id="@+id/watch_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="@string/watch_preview_description"
            android:importantForAccessibility="yes" />

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/watch_theme_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/watch_theme_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_icon_bg"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_palette"
                android:tint="@color/lyra_accent"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/watch_theme_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/lyra_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Midnight Poster" />

                <TextView
                    android:id="@+id/watch_theme_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="12sp"
                    tools:text="Custom theme • Poster layout" />

            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/lyra_text_secondary"
                tools:ignore="UseAppTint" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/watch_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/lyra_background"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/lyra_accent"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/lyra_ripple"
        app:tabSelectedTextColor="@color/lyra_accent"
        app:tabSelectedTextAppearance="@style/LyraTabText"
        app:tabTextAppearance="@style/LyraTabText"
        app:tabTextColor="@color/lyra_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lyra_divider" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/watch_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
