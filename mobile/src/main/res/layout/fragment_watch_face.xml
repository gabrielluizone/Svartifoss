<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The preview owns this area: its size is calculated from the actual space left after the
         toolbar, mini player and bottom navigation are laid out. The 140dp seed prevents a zero-
         size first frame; WatchFaceFragment replaces it with the responsive value immediately. -->
    <FrameLayout
        android:id="@+id/watch_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <com.svartifoss.snfell.view.watchface.WatchPreviewView
            android:id="@+id/watch_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:contentDescription="@string/watch_preview_description"
            android:importantForAccessibility="yes" />

    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/watch_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/lyra_background"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/lyra_accent"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/lyra_ripple"
        app:tabSelectedTextColor="@color/lyra_accent"
        app:tabSelectedTextAppearance="@style/LyraTabText"
        app:tabTextAppearance="@style/LyraTabText"
        app:tabTextColor="@color/lyra_text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lyra_divider" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/watch_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
