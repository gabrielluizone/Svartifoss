<?xml version="1.0" encoding="utf-8"?>
<!-- One setting in a contextual editor: what it is, what it is set to, and - underneath, where the
     preference has one - the sentence that says what it does.

     A single layout serves both kinds of row. A toggle shows the switch, a choice shows its current
     value and a chevron, and EditorSettingRow hides the other trailing views. The value sits on
     the title's own line rather than being glued onto it ("Title · Value" in one outlined button,
     which is how these were drawn before): title and value each get their own room, the value is
     the thing the eye is looking for, and neither is ellipsized to make space for the other.

     The row is the touch target, not the switch or the chevron, so the whole width answers a tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/editor_row_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/lyra_on_surface"
            android:textSize="14sp"
            tools:text="Progress ring layout" />

        <!-- Wraps to a second line rather than ellipsizing: "While seeking and paused" is the
             value a person most needs to read in full, and the title gives way before it does. -->
        <TextView
            android:id="@+id/editor_row_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:gravity="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:maxWidth="140dp"
            android:textColor="@color/lyra_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Bezel edge" />

        <ImageView
            android:id="@+id/editor_row_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            tools:ignore="ContentDescription,UseAppTint" />

        <!-- Purely a picture of the state: the row above owns the tap and the announcement, so
             this must neither take a click nor become a second focus stop for a screen reader. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/editor_row_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/editor_row_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/google_sans"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:textColor="@color/lyra_text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Hide only the visual arc around the screen. Edge seeking remains an independent option."
        tools:visibility="visible" />

</LinearLayout>
