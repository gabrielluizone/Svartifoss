<?xml version="1.0" encoding="utf-8"?>
<!-- The Background page as two things instead of eleven rows: the artwork underneath, and the
     ordered stack of treatments over it. The legacy preferences remain inflated (but hidden)
     behind this surface and still own every value; the six that describe one particular layer are
     read through the list below, which is where a face can now carry several of each. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/background_editor_artwork_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/background_editor_artwork"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/background_editor_artwork_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_album"
                tools:text="Cover" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/background_editor_blur_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_blur"
                tools:text="Blur radius · 35" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/background_editor_fade_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                tools:text="Crossfade artwork" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/background_editor_layers_heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:text="@string/background_editor_layers"
                    android:textAllCaps="true"
                    android:textColor="@color/lyra_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/background_editor_layers_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="12sp"
                    tools:text="3/8" />

            </LinearLayout>

            <!-- Filled by the fragment: the number of rows is what the user is editing, so it
                 cannot be declared here the way the other editors' fixed controls are. -->
            <LinearLayout
                android:id="@+id/background_editor_layer_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/background_editor_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/background_editor_empty"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/background_editor_add_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/background_editor_add_layer"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_plus"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/background_editor_reset_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/background_editor_reset_layers"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/background_editor_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/background_editor_note"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
