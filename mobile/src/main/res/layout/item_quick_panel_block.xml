<?xml version="1.0" encoding="utf-8"?>
<!-- One block of the quick panel in the editor's list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/action_list_item_background"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/block_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/circle_icon_bg"
        android:contentDescription="@null"
        android:padding="10dp"
        tools:src="@drawable/action_volume_up" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/block_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:textColor="@color/lyra_on_surface"
            android:textSize="16sp"
            tools:text="Volume" />

        <TextView
            android:id="@+id/block_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="13sp"
            tools:text="Steps of 10%" />

        <!-- Shown under the block after which the watch's first screen ends. -->
        <TextView
            android:id="@+id/block_fold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:text="@string/quick_panel_editor_fold"
            android:textColor="@color/lyra_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/lyra_text_secondary"
        tools:ignore="UseAppTint" />

</LinearLayout>
