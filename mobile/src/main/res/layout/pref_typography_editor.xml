<?xml version="1.0" encoding="utf-8"?>
<!-- A contextual text editor rather than 28 vertically stacked preference rows. The ordinary
     preferences remain inflated (but hidden) behind this surface and still own every value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/typography_font_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/category_wf_typography_font"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_font_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_text_fields"
                tools:text="Google Sans" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/typography_all_screens_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/setting_wear_font_all_screens"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_flex_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_wf_typography_flex"
                android:visibility="gone"
                app:icon="@drawable/ic_tune"
                tools:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:id="@+id/typography_target_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/typography_target_group"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            app:checkedButton="@id/typography_target_title"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_title"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="@string/category_wf_typography_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_artist"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="@string/category_wf_typography_artist" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_track_time"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/category_wf_typography_track_time" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_clock"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="76dp"
                android:text="@string/category_wf_clock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_icon"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/category_wf_typography_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_target_lyrics"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/action_open_lyrics" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/typography_visibility_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                tools:text="Show song title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_element_font_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:visibility="gone"
                app:icon="@drawable/ic_text_fields"
                tools:text="Follow track font"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_element_flex_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/category_wf_typography_flex"
                android:visibility="gone"
                app:icon="@drawable/ic_tune"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/typography_toolbar_scroll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_weight_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="84dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        tools:text="B 400" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_italic_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:checkable="true"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:text="I"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="italic"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_size_decrease_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/setting_wear_title_font_scale"
                        app:icon="@drawable/ic_text_decrease"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_size_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="68dp"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        tools:text="100%" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_size_increase_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/setting_wear_title_font_scale"
                        app:icon="@drawable/ic_text_increase"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_opacity_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="84dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_opacity"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        tools:text="100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_tracking_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="80dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_tune"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        tools:text="0" />

                    <!-- Icon-only, unlike its neighbours: the icon itself is the value (match
                         case / UPPERCASE / lowercase / Title Case), so there is nothing a text label would add
                         that the glyph does not already say - and the toolbar has no room to say
                         it twice. Opens the same four-way ListPreference dialog every other
                         choice-type control in this editor opens. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typography_case_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        app:icon="@drawable/ic_match_case"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_behavior_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_tune"
                tools:text="Automatic (shrink, then wrap, then scroll)" />

            <!-- The shadow's entry point. Its colour and intensity below only appear once a style
                 has been chosen: with no shadow there is nothing for either to change, and a
                 control that changes nothing reads as broken rather than as inapplicable. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_shadow_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_dark_mode"
                tools:text="Shadow: Soft" />

            <LinearLayout
                android:id="@+id/typography_shadow_detail_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typography_shadow_color_button"
                    style="@style/LyraGestureButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_palette"
                    tools:text="Black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typography_shadow_strength_button"
                    style="@style/LyraGestureButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_text_fields"
                    tools:text="100%" />

            </LinearLayout>

            <!-- The picked colour, shown only while the mode above is Custom. Without it the mode
                 could be set to Custom and the colour behind it never chosen, because that row is
                 hidden on this page and the mode dialog only reports an actual change - so
                 re-picking Custom to reach the swatch did nothing. Same pair as the Colors page. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_shadow_custom_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_palette"
                tools:text="Custom color" />

            <!-- Same shape as the shadow above: the entry point is always offered, its colour
                 appears once there is a stroke to colour. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_outline_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_border_color"
                tools:text="Outline: Thin" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_outline_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_palette"
                tools:text="Black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_outline_custom_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_palette"
                tools:text="Custom color" />

            <!-- The plate behind the words, with its colour and opacity appearing together once
                 there is a plate to describe - the same shape as the shadow row above. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_backdrop_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_format_paint"
                tools:text="Backdrop: Highlight" />

            <LinearLayout
                android:id="@+id/typography_backdrop_detail_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typography_backdrop_color_button"
                    style="@style/LyraGestureButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_palette"
                    tools:text="Black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/typography_backdrop_opacity_button"
                    style="@style/LyraGestureButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:icon="@drawable/ic_text_fields"
                    tools:text="100%" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/typography_backdrop_custom_color_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:icon="@drawable/ic_palette"
                tools:text="Custom color" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
