<?xml version="1.0" encoding="utf-8"?>
<!-- A contextual panel editor rather than 17 rows stacked across six groups, mirroring the Text
     and Color pages. The ordinary preferences remain inflated (but hidden) behind this surface and
     still own every value. Each control below is one *role* rather than one key, so the same view
     serves whichever surface the rail has selected - the row order here is the order the visible
     subset appears in, since every target shows only the controls it actually has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/panel_editor_global_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:text="@string/category_wf_panel_shared"
                android:textAllCaps="true"
                android:textColor="@color/lyra_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_backdrop_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_backdrop_style"
                tools:text="Follow panel style" />

            <HorizontalScrollView
                android:id="@+id/panel_editor_global_scroll"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/panel_editor_blur_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:fontFamily="@font/google_sans"
                        android:includeFontPadding="false"
                        android:minWidth="112dp"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_blur"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        tools:text="Blur · 35" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:id="@+id/panel_editor_target_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/panel_editor_target_group"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            app:checkedButton="@id/panel_editor_target_volume"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_target_volume"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/watch_element_volume" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_target_seek"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/watch_element_progress" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_target_quick"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="96dp"
                android:text="@string/watch_element_quick_panel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_target_queue"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/watch_element_queue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_target_lyrics"
                style="@style/LyraCommunityDetailSurfaceButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="82dp"
                android:text="@string/watch_element_lyrics" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/lyra_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/lyra_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- The resting progress ring leads the Seek tab: it is on screen all the time, while
                 the seek overlay below it only exists during a drag. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_ring_style_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_progress_ring"
                tools:text="Solid"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_ring_layout_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_tune"
                tools:text="Bezel edge"
                tools:visibility="visible" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/panel_editor_ring_gradient_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Blend the palette"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_surface_backdrop_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_backdrop_style"
                tools:text="Queue background · Follow shared panel appearance"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_style_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                app:icon="@drawable/ic_progress_style"
                tools:text="Glass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_layout_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_tune"
                tools:text="Edge"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_row_size_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_playlist_play"
                tools:text="Normal"
                tools:visibility="visible" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/panel_editor_up_next_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Show Up next"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_up_next_style_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_queue_music"
                tools:text="Follow panel style"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_source_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_joystick"
                tools:text="Configured actions"
                tools:visibility="visible" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/panel_editor_shortcut_cover_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Shortcut covers"
                tools:visibility="visible" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/panel_editor_remote_artwork_switch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/google_sans"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_on_surface"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Download queue covers"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/panel_editor_shortcuts_button"
                style="@style/LyraGestureButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                app:icon="@drawable/ic_playlist_add"
                tools:text="Streaming shortcuts"
                tools:visibility="visible" />

            <!-- How the panel these settings style is actually opened on the watch is not obvious
                 from anywhere else on this screen, so the note travels with the controls. -->
            <TextView
                android:id="@+id/panel_editor_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Double-tap the centre of the player to open it."
                tools:visibility="visible" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
