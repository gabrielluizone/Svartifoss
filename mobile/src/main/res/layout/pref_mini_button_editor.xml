<?xml version="1.0" encoding="utf-8"?>
<!-- The Mini buttons page, in the same contextual shape as its five siblings.

     One card per subject, built from MiniButtonEditorModel at bind time and drawn with the same
     rows as the Player page: Mini buttons (the way out to where their actions are assigned, and
     when the row appears), Appearance (arrangement, shape, background, opacity) and, on its own
     with no heading because its single row names itself, the screen gestures that share this page.

     It used to be one card holding all of the first three as outlined "Label · value" buttons
     under a note, with the gestures card showing a value ("Always") and nothing to say what it was
     the value of. The link to Controls is first because assigning what a mini button actually
     *does* happens there, not here, and that is the first question anybody arriving on this page
     has.

     A face that hosts the row inside its own composition places and shapes the buttons itself, so
     it is not offered an arrangement or a shape - which rows appear is decided at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="18dp">

    <!-- Each card carries its own 10dp top margin, which is also the page's top inset. -->
    <LinearLayout
        android:id="@+id/mini_button_editor_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
