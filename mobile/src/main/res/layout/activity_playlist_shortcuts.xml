<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- AppTheme is NoActionBar, so the page carries its own title. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:text="@string/setting_playlist_shortcuts"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/google_sans"
        android:lineSpacingExtra="2dp"
        android:text="@string/playlist_shortcuts_help"
        android:textColor="@color/lyra_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/google_sans"
        android:gravity="center"
        android:text="@string/playlist_shortcuts_none"
        android:textColor="@color/lyra_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <!-- Centered despite the style's start alignment: a lone static button has no row-alignment
         or rebind concerns, so MaterialButton's centered-icon math is safe here. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_add"
        style="@style/LyraGestureButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/playlist_shortcuts_add"
        app:icon="@drawable/ic_plus" />

</LinearLayout>
