<?xml version="1.0" encoding="utf-8"?>

<!-- Single settings-style entry row for the quick actions panel configuration (opens a
     dialog with the four slots), then the drag-to-reorder watch menu action list below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:fontFamily="@font/google_sans"
        android:text="@string/actions_intro"
        android:textColor="@color/lyra_pref_summary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="56dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:fontFamily="@font/google_sans"
        android:letterSpacing="0.1"
        android:text="@string/actions_quick_panel_section"
        android:textAllCaps="true"
        android:textColor="@color/lyra_accent"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/quick_panel_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_gamepad"
            android:tint="@color/lyra_text_secondary"
            tools:ignore="ContentDescription,UseAppTint" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-3dp"
                android:fontFamily="@font/google_sans"
                android:text="@string/quick_panel_row_title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/quick_panel_row_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:fontFamily="@font/google_sans"
                android:textColor="@color/lyra_pref_summary"
                android:textSize="13sp"
                tools:text="Like · Shuffle · Repeat · Up Next" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/lyra_text_secondary"
            tools:ignore="ContentDescription,UseAppTint" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lyra_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="56dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:fontFamily="@font/google_sans"
        android:letterSpacing="0.1"
        android:text="@string/actions_watch_menu_section"
        android:textAllCaps="true"
        android:textColor="@color/lyra_accent"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/action_list_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="56dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        android:fontFamily="@font/google_sans"
        android:textColor="@color/lyra_pref_summary"
        android:textSize="12sp"
        tools:text="8 actions · Tap to edit · Hold and drag to reorder" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/actions_reorder_description" />

        <TextView
            android:id="@+id/action_list_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/actions_empty"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
