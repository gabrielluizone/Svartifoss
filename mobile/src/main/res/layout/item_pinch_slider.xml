<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/label" style="@style/PinchSection"
        android:layout_width="0dp" android:layout_marginEnd="12dp" android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/value" />
    <TextView android:id="@+id/value" style="@style/PinchBody"
        android:layout_width="wrap_content" android:gravity="end" android:textAlignment="viewEnd"
        android:textColor="@color/lyra_on_surface"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBaseline_toBaselineOf="@id/label" />
    <androidx.constraintlayout.widget.Barrier android:id="@+id/heading_bottom"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:barrierDirection="bottom" app:constraint_referenced_ids="label,value" />
    <androidx.appcompat.widget.AppCompatSeekBar android:id="@+id/slider"
        android:layout_width="0dp" android:layout_height="48dp"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/heading_bottom"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@+id/help" style="@style/PinchBody" android:layout_width="0dp"
        android:textSize="13sp" android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slider" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
