<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/community_theme_account_delete_choice_prompt"
        android:textColor="@color/lyra_text_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/community_account_delete_choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/community_account_delete_keep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:minHeight="44dp"
            android:text="@string/community_theme_account_delete_keep_themes"
            android:textColor="@color/lyra_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/community_theme_account_delete_keep_themes_detail"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/community_account_delete_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:minHeight="44dp"
            android:text="@string/community_theme_account_delete_remove_themes"
            android:textColor="@color/lyra_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/community_theme_account_delete_remove_themes_detail"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="12sp" />

    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/google_sans"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:text="@string/community_theme_account_delete_irreversible"
        android:textColor="?attr/colorError"
        android:textSize="12sp" />

</LinearLayout>
