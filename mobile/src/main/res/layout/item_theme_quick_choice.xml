<?xml version="1.0" encoding="utf-8"?>
<!-- One theme in the quick theme window (ThemeQuickSwitchActivity): its name, the layout it is
     built on, and a check on the one in use. Both lines may wrap or ellipsize, since a saved
     theme's name is whatever its author typed and the layout name is translated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="16sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:textColor="@color/lyra_on_surface" />

        <TextView
            android:id="@+id/choice_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/google_sans"
            android:textColor="@color/lyra_text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/choice_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_check_circle"
        android:importantForAccessibility="no" />

</LinearLayout>
