<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lyra_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left"
            android:tint="@color/lyra_on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:text="@string/community_theme_submit_title"
            android:textColor="@color/lyra_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/lyra_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lyra_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.svartifoss.snfell.view.watchface.WatchPreviewView
                        android:id="@+id/submission_preview"
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:contentDescription="@string/community_theme_submit_preview_description" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/submission_theme_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/google_sans"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="@color/lyra_on_surface"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/submission_theme_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/google_sans"
                            android:includeFontPadding="false"
                            android:textColor="@color/lyra_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/google_sans"
                            android:includeFontPadding="false"
                            android:text="@string/community_theme_submit_intro"
                            android:textColor="@color/lyra_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/public_name_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/community_theme_submit_public_name"
                app:counterEnabled="true"
                app:counterMaxLength="48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/public_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="48"
                    android:maxLines="1"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/author_layout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/community_theme_submit_author"
                app:counterEnabled="true"
                app:counterMaxLength="48"
                app:helperText="@string/community_theme_submit_author_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/author_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:imeOptions="actionDone"
                    android:inputType="textCapWords"
                    android:maxLength="48"
                    android:maxLines="1"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/submission_originality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:textColor="@color/lyra_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/lyra_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lyra_divider"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/google_sans"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:padding="14dp"
                    android:text="@string/community_theme_submit_privacy"
                    android:textColor="@color/lyra_text_secondary"
                    android:textSize="12sp" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/submission_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/google_sans"
                android:includeFontPadding="false"
                android:textColor="?attr/colorError"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/submission_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:contentDescription="@string/community_theme_submit_progress"
                android:indeterminateTint="@color/lyra_accent"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_submit_theme"
                style="@style/LyraFilledButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="@string/community_theme_submit_button"
                app:icon="@drawable/ic_upload_file" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
