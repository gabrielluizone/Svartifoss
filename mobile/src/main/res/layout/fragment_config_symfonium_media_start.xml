<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/symfonium_media_type" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/symfonium_media_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/symfonium_media_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/symfonium_media_name"
            android:inputType="text" />

        <EditText
            android:id="@+id/symfonium_media_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/symfonium_media_artist"
            android:inputType="text" />

        <EditText
            android:id="@+id/symfonium_media_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/symfonium_media_album"
            android:inputType="text" />

        <EditText
            android:id="@+id/symfonium_media_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/symfonium_media_id_optional"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/symfonium_queue_mode" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/symfonium_queue_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/symfonium_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/symfonium_resume" />

        <CheckBox
            android:id="@+id/symfonium_shuffle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/symfonium_shuffle" />

    </LinearLayout>
</ScrollView>
