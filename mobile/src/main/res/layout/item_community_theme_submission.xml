<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/lyra_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lyra_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/submission_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/submission_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:textColor="@color/lyra_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/submission_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/submission_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawablePadding="6dp"
            android:fontFamily="@font/google_sans"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/lyra_on_surface"
            android:textSize="13sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_favorite"
            app:drawableTint="@color/lyra_text_secondary" />

        <TextView
            android:id="@+id/submission_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/google_sans"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/lyra_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submission_remove"
            style="@style/LyraGestureButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/community_theme_submissions_remove"
            android:textColor="?attr/colorError" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
