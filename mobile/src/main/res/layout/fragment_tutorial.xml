<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/google_sans"
            android:text="@string/tutorial_header"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/google_sans"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/tutorial_intro"
            android:textColor="@color/lyra_pref_summary"
            android:textSize="14sp" />

        <!-- Put the first useful decision before the full reference. This is also a compact map
             of the two configuration surfaces a new user needs most often. -->
        <TextView
            android:id="@+id/tutorial_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/dialog_bg_lyra"
            android:fontFamily="@font/google_sans"
            android:lineSpacingMultiplier="1.15"
            android:padding="16dp"
            android:text="@string/tutorial_tip"
            android:textColor="@color/lyra_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/google_sans"
            android:text="@string/controls_header"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Tap zones -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_taps" />

        <!-- Single/double/long press -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_gestures" />

        <!-- Physical buttons -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_buttons" />

        <!-- Rotary -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_rotary" />

        <!-- Swipe gestures (up/down/left/right, all configurable) -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_swipe_up" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/google_sans"
            android:text="@string/actions_menu"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Quick actions are configured separately from screen inputs, under Actions. -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_quick_panel" />

        <!-- Streaming shortcuts. Placed before the liked-songs card, which is the one-tap special
             case of the same idea - this is the general mechanism behind it. -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_shortcuts" />

        <!-- YouTube Music shortcuts -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_yt_music" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/google_sans"
            android:text="@string/category_watch_navigation"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Swipe to exit -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_exit" />

        <!-- Tile -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_tile" />

        <!-- Watch face complication -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_complication" />

        <!-- System media controls -->
        <include
            layout="@layout/item_tutorial_card"
            android:id="@+id/card_system" />

    </LinearLayout>

</ScrollView>
