    <string name="pinch_recalibrate_watch">다시 보정</string>
    <string name="pinch_open_instruction">시계에서 Svartifoss를 여세요. 그곳에서 테스트를 진행하고 보정을 저장하세요.</string>
    <string name="pinch_open_sending">시계에 연결하는 중…</string>
