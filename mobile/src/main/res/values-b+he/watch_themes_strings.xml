    <string name="community_theme_submit_author">שם מחבר ציבורי</string>
    <string name="community_theme_submit_author_helper">בחרו פעם אחת: A–Z, 0–9, רווחים, נקודה, קו תחתון, גרש או מקף. השם ייחודי ונשאר קבוע עד למחיקת החשבון.</string>
    <string name="community_theme_submit_author_first_anonymous_helper">השם הזה נשמר לצמיתות לחשבון שלך, אבל ערכת הנושא הזו תציג „אנונימי”.</string>
    <string name="community_theme_submit_author_fixed_helper">שם ציבורי קבוע לחשבון הזה. לא ניתן לשנות אותו כל עוד החשבון קיים.</string>
    <string name="community_theme_submit_author_fixed_anonymous_helper">שם קבוע לחשבון הזה. ערכת הנושא הזו תסתיר אותו ותציג „אנונימי”.</string>
    <string name="community_theme_submit_publish_anonymously">פרסום כאנונימי</string>
    <string name="community_theme_submit_privacy">הכניסה מזהה את ההגשה מול Svartifoss, אך השם והאימייל שלך ב-Google אינם מתפרסמים. שם המחבר הייחודי שלך קשור לחשבון הזה עד שהחשבון נמחק. פרסום כאנונימי מסתיר אותו רק בערכת הנושא הזו.</string>
