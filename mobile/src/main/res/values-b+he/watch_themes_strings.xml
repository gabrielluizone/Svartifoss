    <string name="community_theme_submit_originality">ערכת הנושא הזו משנה %1$d הגדרות חזותיות רלוונטיות. נדרשות לפחות %2$d לפני שניתן יהיה לבדוק אותה.</string>
    <string name="community_theme_submit_invalid">לא ניתן להגיש את ערכת הנושא השמורה הזו. חזרו לערכות הנושא שלי ונסו שוב.</string>
    <string name="community_theme_submit_unsupported_setting_value">הגלריה לא יכולה לקבל „%2$s” עבור %1$s. שנו את ההגדרה הזו בערכת הנושא והגישו שוב.</string>
