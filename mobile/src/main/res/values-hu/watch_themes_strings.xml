    <string name="community_theme_account_delete_keep_themes">Közzétett témáim megtartása</string>
    <string name="community_theme_account_delete_keep_themes_detail">A galériában maradnak azon a szerzőnéven, amellyel közzétették őket, és megszűnik a kapcsolatuk a fiókjával.</string>
    <string name="community_theme_account_delete_remove_themes">Közzétett témáim törlése is</string>
