    <string name="community_theme_submit_title">Senda inn þema</string>
    <string name="community_theme_submit_preview_description">Forskoðun á þemanu sem verið er að senda inn</string>
    <string name="community_theme_submit_intro">Það verður yfirfarið áður en það birtist í Samfélagsþemum. Þú getur sent inn allt að 10 þemu á hverjum 24 klukkustundum.</string>
    <string name="community_theme_submit_public_name">Opinbert þemanafn</string>
    <string name="community_theme_submit_author">Opinbert höfundarnafn</string>
    <string name="community_theme_submit_author_helper">Veldu einu sinni: A–Z, 0–9, bil, punkt, undirstrik, úrfellingarmerki eða bandstrik. Það er einstakt og helst fast þar til þú eyðir reikningnum.</string>
    <string name="community_theme_submit_author_first_anonymous_helper">Þetta nafn er varanlega frátekið fyrir reikninginn þinn, en þetta þema sýnir Nafnlaus.</string>
    <string name="community_theme_submit_author_fixed_helper">Fast opinbert nafn fyrir þennan reikning. Ekki er hægt að breyta því meðan reikningurinn er til.</string>
    <string name="community_theme_submit_author_fixed_anonymous_helper">Fast nafn fyrir þennan reikning. Þetta þema felur það og sýnir Nafnlaus.</string>
    <string name="community_theme_submit_publish_anonymously">Birta sem Nafnlaus</string>
    <string name="community_theme_submit_privacy">Innskráning auðkennir innsendinguna fyrir Svartifoss, en Google-nafnið þitt og netfang eru ekki birt. Einstaka höfundarnafnið þitt er tengt þessum reikningi þar til honum er eytt. Birta sem Nafnlaus felur það aðeins á þessu þema.</string>
    <string name="community_theme_submit_button">Skrá inn og senda</string>
    <string name="community_theme_submit_button_connected">Senda inn þema</string>
    <string name="community_theme_submit_progress">Sendi inn þemað þitt…</string>
    <string name="community_theme_submit_name_required">Sláðu inn opinbert þemanafn.</string>
    <string name="community_theme_submit_author_required">Sláðu inn gilt höfundarnafn með bókstöfunum A–Z, tölum og leyfðum skiljum.</string>
    <string name="community_theme_submit_author_unavailable">Þetta höfundarnafn er þegar frátekið af öðrum reikningi. Veldu annað.</string>
    <string name="community_theme_submit_author_locked">Þessi reikningur birtir þegar sem %1$s. Fasta nafnið hefur verið endurheimt; skoðaðu það og sendu aftur.</string>
    <string name="community_theme_submit_originality">Þetta þema breytir %1$d viðeigandi sjónrænum stillingum. Að minnsta kosti %2$d þarf áður en hægt er að yfirfara það.</string>
    <string name="community_theme_submit_invalid">Ekki er hægt að senda inn þetta vistaða þema. Farðu aftur í Mín þemu og reyndu aftur.</string>
    <string name="community_theme_submit_unsupported_setting_value">Safnið getur ekki tekið við „%2$s“ fyrir %1$s. Breyttu þeirri stillingu á þessu þema og sendu aftur.</string>
    <string name="community_theme_submit_unsupported_setting">Safnið getur ekki tekið við %1$s-stillingu þessa þema. Breyttu henni og sendu þemað aftur.</string>
    <string name="community_theme_submit_device_local">%1$s notar skrá úr símanum þínum, þannig að aðeins er hægt að nota þetta þema hér — galleríið flytur stillingar, ekki eigin leturgerðir eða myndir.</string>
    <string name="community_theme_submit_device_local_generic">Þetta þema notar letur eða mynd úr símanum þínum og því er aðeins hægt að nota það hér — galleríið flytur stillingar, ekki þínar eigin skrár.</string>
    <string name="community_theme_submit_duplicate">Þema með nákvæmlega þessum stillingum er þegar birt á þessu útliti. Breyttu einhverju sýnilegu áður en þú sendir inn.</string>
    <string name="community_theme_submit_sign_in_cancelled">Google-innskráningu var hætt. Þemað þitt var ekki sent inn.</string>
    <string name="community_theme_submit_limit_reached">Þú hefur þegar sent 10 þemu á þessu 24 klukkustunda tímabili. Reyndu aftur þegar því lýkur.</string>
    <string name="community_theme_submit_error">Ekki tókst að senda inn þetta þema. Athugaðu tenginguna og reyndu aftur.</string>
    <string name="community_theme_submit_preview_error">Ekki tókst að undirbúa forskoðun fyrir yfirferð. Reyndu aftur.</string>
    <string name="community_theme_submit_success_title">Sent inn til yfirferðar</string>
    <string name="community_theme_submit_success_message">Þemað þitt bíður yfirferðar. Það er ekki opinbert enn.</string>
    <string name="community_theme_submit_picker_action">Senda inn þemun þín</string>
    <string name="community_theme_submit_picker_title">Veldu allt að %1$d þemu</string>
    <string name="community_theme_submit_picker_confirm">Halda áfram</string>
    <string name="community_theme_submit_picker_limit">Þú getur sent inn allt að %1$d þemu á hverjum 24 klukkustundum.</string>
