    <string name="community_theme_account_title">Samfélagsreikningur</string>
    <string name="community_theme_account_status_google">Google-reikningur tengdur</string>
    <string name="community_theme_account_google_email">Tengdur sem %1$s. Google-nafnið þitt og netfang eru ekki opinber.</string>
    <string name="community_theme_account_google_detail">Google-auðkennið þitt getur sent inn þemu. Google-prófílnafnið þitt helst einkamál.</string>
    <string name="community_theme_account_public_author_claimed">Opinber höfundur: %1$s\nÞetta nafn er einstakt og ekki hægt að breyta því meðan þessi reikningur er til.</string>
    <string name="community_theme_account_public_author_unclaimed">Opinber höfundur hefur ekki verið valinn enn. Fyrsta innsendingin þín áskilur eitt einstakt nafn fyrir þennan reikning.</string>
    <string name="community_theme_account_status_anonymous">Nafnlaus líkarreikningur</string>
    <string name="community_theme_account_anonymous_detail">Þetta tæki er með einkarekinn nafnlausan Firebase-reikning fyrir líkar. Tengdu Google til að senda inn þemu og halda gjaldgengum líkum á þessu tæki.</string>
    <string name="community_theme_account_status_signed_out">Enginn samfélagsreikningur tengdur</string>
    <string name="community_theme_account_signed_out_detail">Áfram er hægt að skoða án reiknings. Tengdu Google einu sinni til að senda inn þemu; tengingin er geymd á þessu tæki.</string>
    <string name="community_theme_account_sign_in">Skrá inn með Google</string>
    <string name="community_theme_account_sign_out">Fjarlægja af þessu tæki</string>
    <string name="community_theme_account_connecting">Tengi Google-reikninginn þinn…</string>
    <string name="community_theme_account_connected">Google-reikningur tengdur</string>
    <string name="community_theme_account_sign_in_cancelled">Google-innskráningu var hætt.</string>
    <string name="community_theme_account_sign_in_error">Ekki tókst að tengja Google-reikninginn þinn. Athugaðu tenginguna og reyndu aftur.</string>
    <string name="community_theme_account_sign_out_title">Fjarlægja samfélagsreikninginn af þessu tæki?</string>
    <string name="community_theme_account_sign_out_message">Þetta skráir þig aðeins út á þessu tæki. Það eyðir ekki Google-reikningnum þínum, innsendum þemum, opinberum skráningum eða gögnum sem Firebase hefur þegar. Lík frá þessu tæki birtast ekki hér aftur fyrr en samsvarandi reikningur er tengdur aftur.</string>
    <string name="community_theme_account_sign_out_confirm">Fjarlægja</string>
    <string name="community_theme_account_disconnected">Samfélagsreikningur fjarlægður af þessu tæki</string>
    <string name="community_theme_account_remove_title">Eyða þessum reikningi</string>
    <string name="community_theme_account_remove_detail">Að fjarlægja reikninginn af þessu tæki skráir þig aðeins út. Að eyða honum fjarlægir auðkenni þitt, innsendingarferil og líkar og losar höfundarnafnið þegar eyðingu lýkur — þú velur einnig hvað gerist við birt þemu.</string>
    <string name="community_theme_account_delete">Eyða reikningi</string>
    <string name="community_theme_account_delete_title">Eyða samfélagsreikningnum þínum?</string>
    <string name="community_theme_account_delete_choice_prompt">Auðkenni þitt, innsendingarferill og líkar verða fjarlægð. Veldu hvað gerist við þemu sem þú hefur þegar birt.</string>
    <string name="community_theme_account_delete_keep_themes">Halda birtu þemunum mínum</string>
    <string name="community_theme_account_delete_keep_themes_detail">Þau verða áfram í safninu undir höfundarnafninu sem þau voru birt með og hætta að vera tengd reikningnum þínum.</string>
    <string name="community_theme_account_delete_remove_themes">Eyða einnig birtu þemunum mínum</string>
    <string name="community_theme_account_delete_remove_themes_detail">Þau eru tekin úr safninu ásamt líkum sínum. Allir sem þegar hafa sett eitt upp halda sínu eintaki í eigin síma.</string>
    <string name="community_theme_account_delete_irreversible">Þetta er ekki hægt að afturkalla og lýkur innan um eins dags. Þemum sem bíða yfirferðar er alltaf eytt.</string>
    <string name="community_theme_account_delete_confirm">Eyða reikningi</string>
    <string name="community_theme_account_delete_confirm_title">Eyða þessum reikningi fyrir fullt og allt?</string>
