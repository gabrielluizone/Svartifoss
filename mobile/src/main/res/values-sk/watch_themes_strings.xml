    <string name="community_theme_account_status_anonymous">Anonymný účet hodnotení</string>
    <string name="community_theme_account_anonymous_detail">Toto zariadenie má súkromný anonymný účet Firebase pre hodnotenia Páči sa mi. Pripojte Google, aby ste mohli odosielať motívy a zároveň zachovali oprávnené hodnotenia na tomto zariadení.</string>
