    <string name="community_theme_account_sign_out_message">Týmto sa odhlásite iba na tomto zariadení. Váš účet Google, odoslané motívy, verejné záznamy ani údaje, ktoré už Firebase uchováva, sa neodstránia. Hodnotenia z tohto zariadenia sa tu znova nezobrazia, kým nebude znovu pripojený zodpovedajúci účet.</string>
    <string name="community_theme_account_sign_out_confirm">Odstrániť</string>
    <string name="community_theme_account_disconnected">Komunitný účet bol z tohto zariadenia odstránený</string>
    <string name="community_theme_account_remove_title">Odstrániť tento účet</string>
    <string name="community_theme_account_remove_detail">Odstránenie účtu z tohto zariadenia vás iba odhlási. Jeho vymazanie odstráni vašu identitu, históriu odoslaní a hodnotenia a po dokončení odstránenia uvoľní meno autora — zároveň zvolíte, čo sa stane so zverejnenými motívmi.</string>
    <string name="community_theme_account_delete">Odstrániť účet</string>
    <string name="community_theme_account_delete_title">Odstrániť váš komunitný účet?</string>
    <string name="community_theme_account_delete_choice_prompt">Vaša identita, história odoslaní a hodnotenia Páči sa mi budú odstránené. Vyberte, čo sa má stať s motívmi, ktoré ste už zverejnili.</string>
    <string name="community_theme_account_delete_keep_themes">Ponechať moje zverejnené motívy</string>
    <string name="community_theme_account_delete_keep_themes_detail">Zostanú v galérii pod menom autora, s ktorým boli zverejnené, a prestanú byť prepojené s vaším účtom.</string>
    <string name="community_theme_account_delete_remove_themes">Odstrániť aj moje zverejnené motívy</string>
    <string name="community_theme_account_delete_remove_themes_detail">Budú stiahnuté z galérie spolu s ich hodnoteniami. Každý, kto už niektorý nainštaloval, si ponechá svoju kópiu v telefóne.</string>
    <string name="community_theme_account_delete_irreversible">Túto akciu nemožno vrátiť a dokončí sa približne do jedného dňa. Motívy čakajúce na kontrolu sa vždy odstránia.</string>
    <string name="community_theme_account_delete_confirm">Odstrániť účet</string>
    <string name="community_theme_account_delete_confirm_title">Natrvalo odstrániť tento účet?</string>
    <string name="community_theme_account_delete_confirm_keep">Váš účet, história odoslaní a hodnotenia budú odstránené. Zverejnené motívy zostanú v galérii a už s vami nebudú prepojené.</string>
    <string name="community_theme_account_delete_confirm_remove">Váš účet, história odoslaní a hodnotenia budú odstránené a zverejnené motívy budú stiahnuté z galérie.</string>
    <string name="community_theme_account_delete_requested">Požiadavka na odstránenie účtu odoslaná</string>
