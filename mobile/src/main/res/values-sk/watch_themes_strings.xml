    <string name="community_theme_submit_originality">Tento motív mení %1$d použiteľných vizuálnych nastavení. Aby mohol byť skontrolovaný, je potrebných aspoň %2$d.</string>
    <string name="community_theme_submit_invalid">Tento uložený motív nemožno odoslať. Vráťte sa do Mojich motívov a skúste to znova.</string>
