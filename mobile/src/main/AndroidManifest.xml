<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ replacement for READ_EXTERNAL_STORAGE, which stopped being grantable at
         targetSdk 33. Used only to decode MediaStore album art for playback-queue entries whose
         player publishes covers as content:// library URIs (see QueueArtworkResolver); the queue
         degrades to blank thumbnails when it is not granted, so it is requested in context rather
         than at startup. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="net.dinglisch.android.tasker.PERMISSION_RUN_TASKS" />
    <uses-permission android:name="com.matejdro.wearvibrationcenter.RECEIVE_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the sideloaded app install its own downloaded update APK (still gated on the user's
         one-time "install unknown apps" grant). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-sdk
        tools:overrideLibrary="androidx.wear" />

    <queries>
        <package android:name="net.dinglisch.android.tasker"/>
        <package android:name="net.dinglisch.android.taskerm"/>
        <package android:name="com.matejdro.wearvibrationcenter"/>

        <!-- Package visibility for Streaming shortcuts (Beta): used only to decide whether an
             ACTION_VIEW link can be targeted and to show the installed app's own icon. -->
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.spotify.music" />
        <package android:name="deezer.android.app" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.soundcloud.android" />

        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- Lets MusicService discover a music app's MediaBrowserService for library search
             (see MediaBrowserSearch.kt) - the standard declaration used by Android Auto and
             assistants for the same purpose. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- The same discovery for apps built on Media3, which are under no obligation to publish
             the legacy action above and increasingly do not (see MediaBrowserSearch.kt's
             BROWSER_SERVICE_ACTIONS). These resolve today only because the MAIN/LAUNCHER entry
             below happens to make every app with an icon visible; declaring them keeps the lookup
             working on its own terms rather than on that side effect. -->
        <intent>
            <action android:name="androidx.media3.session.MediaLibraryService" />
        </intent>
        <intent>
            <action android:name="androidx.media3.session.MediaSessionService" />
        </intent>
        <!-- Lets the "which apps count as music" list (MusicAppListPreference) enumerate installed
             apps that have a launcher icon on Android 11+ (API 30+), where getInstalledPackages()
             is otherwise filtered to only the packages declared above. This is the Play-policy-safe
             alternative to QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".WearMusicCenter"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config"
        tools:ignore="AllowBackup,GoogleAppIndexingWarning">
        <!-- Firebase's provider starts before Application.onCreate. Automatic Crashlytics upload
             therefore stays off permanently; CrashReporting sends or deletes queued reports only
             after reading the local privacy preference (which defaults to enabled). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <activity
            android:name=".view.mainactivity.MainActivity"
            android:exported="true"
            android:label="@string/app_name_short"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".NotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <service
            android:name=".WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/>

                <data
                    android:host="*"
                    android:pathPrefix="/Messages"
                    android:scheme="wear"/>
            </intent-filter>
        </service>
        <service
            android:name=".music.MusicService"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- Developer announcement push notifications - see AnnouncementNotifications /
             AnnouncementMessagingService. No backend: delivery is entirely topic-based. -->
        <service
            android:name=".notifications.AnnouncementMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_brand"/>

        <service
            android:name="pl.tajchert.exceptionwear.ExceptionDataListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/exceptionwear/wear_error"
                    android:scheme="wear" />
            </intent-filter>
        </service>


        <activity
            android:name=".view.buttonconfig.ActionPickerActivity"
            android:label="@string/pick_action"
            android:theme="@style/AppTheme.Dialog"/>

        <activity
            android:name=".view.actionlist.ActionEditorActivity"
            android:theme="@style/AppTheme.Dialog" />

        <activity
            android:name=".view.watchface.theme.WatchThemesActivity"
            android:exported="false"
            android:label="@string/watch_themes_title"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".view.watchface.theme.OnlineThemesActivity"
            android:exported="false"
            android:label="@string/online_themes_title"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".view.watchface.theme.SubmitCommunityThemeActivity"
            android:exported="false"
            android:label="@string/community_theme_submit_title"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".view.settings.PlaylistShortcutsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/setting_playlist_shortcuts">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.settings.SettingsSearchActivity"
            android:exported="false"
            android:label="@string/settings_search_title"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <activity
            android:name=".update.UpdateActivity"
            android:exported="false"
            android:label="@string/update_screen_title" />

        <activity
            android:name=".view.mainactivity.HelpActivity"
            android:exported="false"
            android:label="@string/tutorial_header"
            android:parentActivityName=".view.mainactivity.MainActivity"
            android:theme="@style/AppTheme.NoActionBar" />


        <provider
            android:authorities="com.svartifoss.snfell.logs"
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_paths" />

        </provider>

        <receiver
            android:name=".update.PhoneInstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <!-- Fires in the NEW app version right after a successful self-update - the
                     reliable place to clean the cached APK and dismiss the install notice. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
