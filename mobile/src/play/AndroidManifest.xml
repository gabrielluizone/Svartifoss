<?xml version="1.0" encoding="utf-8"?>
<!--
  `play` flavor. Belt-and-suspenders: if any transitive dependency declares
  REQUEST_INSTALL_PACKAGES, strip it, so the Play Store artifact never requests the ability to
  install packages. The self-updater code and components are simply absent from this flavor
  (they live in src/github/). See docs/play-store-migration-plan.md.

  AD_ID and its Android-13+ Privacy Sandbox counterpart ACCESS_ADSERVICES_AD_ID are stripped for
  the same reason: firebase-analytics's own manifest declares both (it can use the advertising ID
  for Google-signals features unless told otherwise), and the manifest merger pulls them into
  every variant. The app never reads the advertising ID, and Play Console's "Does your app use
  advertising ID?" declaration is answered "No" - but Play Console cross-checks that answer
  against the merged manifest, and flags "Incomplete advertising ID declaration" if either
  permission is present regardless of the form answer. Removing both here is what makes the
  manifest agree with the declaration.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <application
        android:icon="@mipmap/ic_launcher_play_gradient"
        android:roundIcon="@mipmap/ic_launcher_play_gradient"
        tools:replace="android:icon,android:roundIcon">
        <!-- The shared activity is still the target, but only one alias is exposed to the
             launcher. This prevents a second Play icon from appearing while the user switches
             between the icon styles. There is one alias per common/AppIconStyle, named by its
             aliasName; AppIconStyleContractTest keeps this list and the enum identical. -->
        <activity android:name=".view.mainactivity.MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".LauncherIconGradient"
            android:targetActivity=".view.mainactivity.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_play_gradient"
            android:roundIcon="@mipmap/ic_launcher_play_gradient"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIconSolid"
            android:targetActivity=".view.mainactivity.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_play_solid"
            android:roundIcon="@mipmap/ic_launcher_play_solid"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIconCream"
            android:targetActivity=".view.mainactivity.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_play_cream"
            android:roundIcon="@mipmap/ic_launcher_play_cream"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIconFeather"
            android:targetActivity=".view.mainactivity.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_play_feather"
            android:roundIcon="@mipmap/ic_launcher_play_feather"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
