<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: lets `adb shell am broadcast` stand in for a paired watch, so the
             watch-command path can be exercised on an emulator that has none. DUMP is held by the
             shell and by nothing a user installs, so no app on the phone can reach it. -->
        <receiver
            android:name="com.svartifoss.snfell.debug.SimulatedWatchCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: renders the Watch tab's preview for every value of every setting
             and writes down which ones change nothing. Same DUMP gate as above. -->
        <receiver
            android:name="com.svartifoss.snfell.debug.PreviewSweepReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
